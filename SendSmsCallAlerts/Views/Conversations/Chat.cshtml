@model List<SendSmsCallAlerts.Models.SmsDetail>
@{
    ViewData["Title"] = "Conversation";
}

<div class="signal-conversation-page">
    <div class="signal-conversation-heading">
        <div>
            <span class="signal-conversation-eyebrow">MESSAGE THREAD</span>
            <h1>Conversation</h1>
            <p>Review the thread and send a reply to <strong>@ViewBag.CustomerNumber</strong>.</p>
        </div>
        <a asp-controller="Sms" asp-action="IncomingLogs" class="btn btn-outline-secondary btn-sm"><i class="fa fa-arrow-left me-1" aria-hidden="true"></i> Back to inbox</a>
    </div>

    @if (TempData["StMsg"] != null)
    {
        <div class="alert alert-success" role="status"><b>@TempData["StMsg"]</b></div>
    }
    @if (TempData["ErMsg"] != null)
    {
        <div class="alert alert-danger" role="alert"><b>@TempData["ErMsg"]</b></div>
    }

    <section class="signal-thread" aria-label="SMS conversation">
        <header class="signal-thread-header">
            <div class="signal-thread-avatar"><i class="fa fa-user-o" aria-hidden="true"></i></div>
            <div class="signal-thread-contact"><strong>@ViewBag.CustomerNumber</strong><span>SMS conversation history</span></div>
            <span class="signal-thread-count">@Model.Count message@(Model.Count == 1 ? "" : "s")</span>
        </header>
        <div class="signal-thread-messages">
            @if (Model.Count == 0)
            {
                <div class="signal-thread-empty"><i class="fa fa-comments-o" aria-hidden="true"></i><strong>No messages yet</strong><span>Use the form below to start the conversation.</span></div>
            }
            else
            {
                @foreach (var rec in Model)
                {
                    if (rec.fromNum == ViewBag.CustomerNumber)
                    {
                        <div class="signal-thread-line signal-thread-incoming">
                            <div class="signal-thread-bubble"><p>@rec.smsBody</p><time>@rec.createdOn.ToString("MM-dd-yy HH:mm")</time></div>
                        </div>
                    }
                    else
                    {
                        <div class="signal-thread-line signal-thread-outgoing">
                            <div class="signal-thread-bubble"><p>@rec.smsBody</p><time>@rec.createdOn.ToString("MM-dd-yy HH:mm")</time></div>
                        </div>
                    }
                }
            }
        </div>
        <form asp-action="Create" asp-controller="Conversations" method="post" class="signal-thread-compose">
            <input type="hidden" name="toNum" value="@ViewBag.CustomerNumber" />
            <label for="signal-chat-text">Your reply</label>
            <div class="signal-thread-input-row">
                <textarea class="form-control" id="signal-chat-text" name="smsBody" rows="2" placeholder="Type your message..."></textarea>
                <button class="btn btn-primary" type="submit"><i class="fa fa-paper-plane" aria-hidden="true"></i> Send</button>
            </div>
        </form>
    </section>
</div>
