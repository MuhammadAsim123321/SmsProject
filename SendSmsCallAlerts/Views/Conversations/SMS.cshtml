@model SendSmsCallAlerts.Models.Conversation
@{
    ViewData["Title"] = "Send SMS";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.1/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<style>
    /* ── Page layout ── */
    .sms-page-wrapper { max-width: 860px; margin: 0 auto; padding: 20px 16px; }

    /* ── Send form card ── */
    .send-card { background: #fff; border: 1px solid #dee2e6; border-radius: 8px; padding: 20px 24px; margin-bottom: 24px; box-shadow: 0 1px 4px rgba(0,0,0,.07); }
    .send-card h4 { margin-bottom: 16px; font-weight: 600; color: #333; }
    .twilio-label { font-size: .85rem; color: #555; margin-bottom: 12px; }
    .twilio-label span { font-weight: 600; color: #0d6efd; }

    /* ── Conversation panel ── */
    .conv-panel { background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 8px; overflow: hidden; }
    .conv-header { background: #70b3db; color: #fff; padding: 12px 18px; display: flex; align-items: center; justify-content: space-between; }
    .conv-header .customer-info { display: flex; flex-direction: column; }
    .conv-header .customer-name { font-weight: 700; font-size: 1rem; }
    .conv-header .customer-num  { font-size: .82rem; opacity: .9; }
    .conv-header .msg-count     { font-size: .8rem; background: rgba(255,255,255,.25); border-radius: 20px; padding: 2px 10px; }

    /* ── Message bubbles ── */
    .conv-body { height: 420px; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
    .conv-empty { text-align: center; color: #aaa; margin: auto; font-size: .92rem; }

    .bubble-row { display: flex; }
    .bubble-row.outgoing { justify-content: flex-end; }
    .bubble-row.incoming { justify-content: flex-start; }

    .bubble { max-width: 68%; padding: 10px 14px; border-radius: 16px; font-size: .9rem; line-height: 1.45; position: relative; word-break: break-word; }
    .bubble-row.outgoing .bubble { background: #0d6efd; color: #fff; border-bottom-right-radius: 4px; }
    .bubble-row.incoming .bubble { background: #fff; color: #333; border: 1px solid #e0e0e0; border-bottom-left-radius: 4px; }

    .bubble .bubble-meta { font-size: .72rem; margin-top: 5px; opacity: .75; white-space: nowrap; }
    .bubble-row.outgoing .bubble .bubble-meta { text-align: right; }
    .bubble-row.incoming .bubble .bubble-meta { text-align: left; }

    .bubble .attach-badge { display: inline-block; margin-top: 4px; font-size: .75rem; background: rgba(0,0,0,.12); border-radius: 10px; padding: 1px 8px; }

    /* ── Direction label ── */
    .dir-label { font-size: .7rem; font-weight: 600; letter-spacing: .04em; margin-bottom: 2px; }
    .bubble-row.outgoing .dir-label { text-align: right; color: #0d6efd; }
    .bubble-row.incoming .dir-label { text-align: left; color: #888; }

    /* ── Refresh button ── */
    #btnRefresh { font-size: .82rem; }

    /* ── Spinner ── */
    #convSpinner { text-align: center; padding: 40px; color: #888; }
</style>

<div class="sms-page-wrapper">

    @* ── Alerts ── *@
    @if (TempData["StMsg"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle me-1"></i> <b>@TempData["StMsg"]</b>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErMsg"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa fa-exclamation-circle me-1"></i> <b>@TempData["ErMsg"]</b>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* ── Back link ── *@
    <div class="mb-3">
        <a asp-action="IncomingLogs" asp-controller="Sms" class="btn btn-outline-secondary btn-sm">
            <i class="fa fa-arrow-left me-1"></i> Back to SMS Logs
        </a>
    </div>

    @* ── Send form ── *@
    <div class="send-card">
        <h4><i class="fa fa-paper-plane me-2 text-primary"></i>Send SMS</h4>

        <div class="twilio-label">
            Sending from: <span id="lblTwilioNum">@ViewBag.FromNumber</span>
        </div>

        @using (Html.BeginForm("SendSms", "Conversations", FormMethod.Post,
            new { enctype = "multipart/form-data", id = "sendForm" }))
        {
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">To Number</label>
                    <input type="text" name="toNum" id="toNum" value="@ViewBag.ToNumber"
                           class="form-control" placeholder="e.g. 2125551234" required />
                </div>
            </div>

            <div class="row g-3 mt-1">
                <div class="col-12">
                    <label class="form-label fw-semibold">Message</label>
                    <textarea name="smsBody" class="form-control" rows="3"
                              placeholder="Type your message here…" required></textarea>
                </div>
            </div>

            <div class="row g-3 mt-1">
                <div class="col-12">
                    <label class="form-label fw-semibold">Attach Images (optional)</label>
                    <input type="file" name="file" class="form-control" multiple accept="image/*" />
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-paper-plane me-1"></i> Send
                </button>
                <button type="button" class="btn btn-outline-secondary" id="btnRefresh"
                        onclick="loadConversation()">
                    <i class="fa fa-rotate-right me-1"></i> Refresh Conversation
                </button>
            </div>
        }
    </div>

    @* ── Conversation history panel ── *@
    <div class="conv-panel">
        <div class="conv-header">
            <div class="customer-info">
                <span class="customer-name" id="convCustomerName">Conversation</span>
                <span class="customer-num"  id="convCustomerNum">@ViewBag.ToNumber</span>
            </div>
            <span class="msg-count" id="convMsgCount">Loading…</span>
        </div>

        <div class="conv-body" id="convBody">
            <div id="convSpinner">
                <i class="fa fa-spinner fa-spin fa-2x"></i><br />Loading conversation…
            </div>
        </div>
    </div>

</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.1/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // The customer number pre-filled from the query string (ViewBag.ToNumber)
    var prefilledNum = '@ViewBag.ToNumber';

    function loadConversation(silent) {
        var num = $('#toNum').val().trim() || prefilledNum;
        if (!num) {
            $('#convBody').html('<div class="conv-empty">Enter a phone number above to see the conversation.</div>');
            $('#convMsgCount').text('0 messages');
            return;
        }
        if (!silent) {
            $('#convBody').html('<div id="convSpinner"><i class="fa fa-spinner fa-spin fa-2x"></i><br/>Loading…</div>');
            $('#convMsgCount').text('Loading…');
        }

        $.get('/Conversations/GetConversationJson', { num: num }, function (res) {
            if (!res.success) {
                $('#convBody').html('<div class="conv-empty">Could not load conversation.</div>');
                $('#convMsgCount').text('0 messages');
                return;
            }

            // Update header
            var displayName = res.customerName && res.customerName !== ''
                ? res.customerName
                : 'Customer';
            $('#convCustomerName').text(displayName);
            $('#convCustomerNum').text(res.customerNum || num);
            $('#convMsgCount').text(res.messages.length + ' message' + (res.messages.length !== 1 ? 's' : ''));

            if (res.messages.length === 0) {
                $('#convBody').html('<div class="conv-empty"><i class="fa fa-comments fa-2x mb-2"></i><br/>No messages yet. Send the first one!</div>');
                return;
            }

            var html = '';
            $.each(res.messages, function (i, msg) {
                var isOut = msg.direction !== 'Incoming';
                var rowClass   = isOut ? 'outgoing' : 'incoming';
                var dirLabel   = isOut ? 'You' : (displayName !== 'Customer' ? displayName : 'Customer');
                var attachHtml = msg.attachments > 0
                    ? '<span class="attach-badge"><i class="fa fa-paperclip"></i> ' + msg.attachments + ' attachment' + (msg.attachments > 1 ? 's' : '') + '</span>'
                    : '';

                html +=
                    '<div class="bubble-row ' + rowClass + '">' +
                    '  <div>' +
                    '    <div class="dir-label">' + escapeHtml(dirLabel) + '</div>' +
                    '    <div class="bubble">' +
                    '      <div>' + escapeHtml(msg.body) + '</div>' +
                    '      ' + attachHtml +
                    '      <div class="bubble-meta"><i class="fa fa-clock"></i> ' + escapeHtml(msg.dateTimeFull) +
                    (isOut ? ' ' + statusHtml(msg) : '') + '</div>' +
                    '  </div>' +
                    '</div>';
            });

            $('#convBody').html(html);

            // Scroll to the latest message
            var body = document.getElementById('convBody');
            body.scrollTop = body.scrollHeight;
        }).fail(function () {
            $('#convBody').html('<div class="conv-empty">Error loading conversation.</div>');
            $('#convMsgCount').text('Error');
        });
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g,  '&amp;')
            .replace(/</g,  '&lt;')
            .replace(/>/g,  '&gt;')
            .replace(/"/g,  '&quot;');
    }
    function statusHtml(m) {
        var s = '';
        if (m.isAutomated) s += '<span class="nova-status nova-status--automated mr-1">Automated</span>';
        if (m.status === 'Pending') s += '<span class="nova-status nova-status--pending">Pending</span>';
        else if (m.status === 'SMS Failed') s += '<span class="nova-status nova-status--failed" title="' + escapeHtml(m.failureReason || '') + '">SMS Failed</span>';
        else if (m.isAutomated && m.status === 'Message Sent') s += '<span class="nova-status nova-status--sent">Sent</span>';
        return s;
    }

    // Reload conversation when the user types a different number
    var debounceTimer;
    $('#toNum').on('input', function () {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function () {
            loadConversation();
        }, 600);
    });

    // Initial load on page ready
    $(document).ready(function () {
        loadConversation();
    });
    setInterval(function () { loadConversation(true); }, 15000);
</script>
