@model IEnumerable<SendSmsCallAlerts.Models.User>

@{
    ViewData["Title"] = "Users";
}

<section class="nova-page-head" aria-label="Page heading">
    <div class="nova-heading-group">
        <span class="nova-heading-icon" aria-hidden="true"><i class="fa fa-users"></i></span>
        <div class="nova-heading-copy">
            <span class="nova-eyebrow">ACCOUNT DIRECTORY</span>
            <h1>Users</h1>
            <p>Manage account records and access</p>
        </div>
    </div>
    <div class="nova-page-actions">
        <a asp-action="IncomingLogs" asp-controller="Sms" class="btn btn-outline-secondary btn-sm sg-secondary-action">
        <i class="fa fa-arrow-left me-1"></i> Back to SMS Logs
    </a>
        <a asp-action="Create" class="sg-create-button signal-create-link sg-primary-action">Create New</a>
    </div>
</section>
@if (TempData["StMsg"] != null)
{
    <div class="alert alert-success">
        <b>@TempData["StMsg"]</b>
    </div>
}

<link href="~/css/bootstrapcopyfromlive.min.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/1.12.1/css/dataTables.bootstrap5.min.css" rel="stylesheet" />



<section class="nova-list-card sg-fix-users" aria-label="All Users">
    <div class="nova-list-toolbar">
        <div class="nova-list-heading"><span class="nova-list-heading-icon" aria-hidden="true"><i class="fa fa-list-ul"></i></span><div><h2>All Users</h2><p>Manage account records and access</p></div></div>
        <div class="nova-list-controls"><span class="nova-table-hint"><i class="fa fa-sliders" aria-hidden="true"></i> Use the table filters below</span></div>
    </div>
    <div class="nova-table-viewport">
<table class="table table-bordered table-striped" id="tblRPM">
