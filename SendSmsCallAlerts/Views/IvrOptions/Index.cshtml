@model IEnumerable<SendSmsCallAlerts.Models.IvrOptions>

@{
    ViewData["Title"] = "IVR options";
}

<section class="nova-page-head" aria-label="Page heading">
    <div class="nova-heading-group">
        <span class="nova-heading-icon" aria-hidden="true"><i class="fa fa-sitemap"></i></span>
        <div class="nova-heading-copy">
            <span class="nova-eyebrow">MENU CONFIGURATION</span>
            <h1>IVR options</h1>
            <p>Manage available menu options and their routing</p>
        </div>
    </div>
    <div class="nova-page-actions">
        <a asp-action="IncomingLogs" asp-controller="Sms" class="btn btn-outline-secondary btn-sm sg-secondary-action">
        <i class="fa fa-arrow-left me-1"></i> Back to SMS Logs
    </a>
        <a asp-action="Create" class="sg-create-button signal-create-link sg-primary-action">Create New</a>
    </div>
</section>


<section class="nova-list-card" aria-label="All IVR options">
    <div class="nova-list-toolbar">
        <div class="nova-list-heading"><span class="nova-list-heading-icon" aria-hidden="true"><i class="fa fa-list-ul"></i></span><div><h2>All IVR options</h2><p>Manage available menu options and their routing</p></div></div>
        <div class="nova-list-controls"><label class="nova-search" for="search-novaIvrOptionsTable"><i class="fa fa-search" aria-hidden="true"></i><span class="sr-only">Search All IVR options</span><input type="search" id="search-novaIvrOptionsTable" data-nova-search="novaIvrOptionsTable" placeholder="Search records..." autocomplete="off" /></label></div>
    </div>
    <div class="nova-table-viewport">
<table id="novaIvrOptionsTable" class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayName("Option Number")
            </th>
            <th>
                @Html.DisplayNameFor(model => model.keyword)
            </th>
            <th>
                @Html.DisplayName("Twilio Number")
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Num)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.keyword)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TwilioNum)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="sg-table-link sg-table-link-edit">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="sg-table-link sg-table-link-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
</section>
