@model IEnumerable<SendSmsCallAlerts.Models.IvrOptions>

@{
    ViewData["Title"] = "IVR options";
}

<div class="d-flex justify-content-between align-items-center mb-2 signal-heading-row">
    <h1>Options List</h1>
    <div class="sg-page-actions">
        <a asp-action="IncomingLogs" asp-controller="Sms" class="btn btn-outline-secondary btn-sm sg-secondary-action">
        <i class="fa fa-arrow-left me-1"></i> Back to SMS Logs
    </a>
        <a asp-action="Create" class="sg-create-button signal-create-link sg-primary-action">Create New</a>
    </div>
</div>


<div class="signal-list-card">
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayName("Option Number")
            </th>
            <th>
                @Html.DisplayNameFor(model => model.keyword)
            </th>
            <th>
                @Html.DisplayName("Twilio Number")
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Num)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.keyword)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TwilioNum)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="sg-table-link sg-table-link-edit">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="sg-table-link sg-table-link-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
