@model IEnumerable<SendSmsCallAlerts.Models.ForwardNum>

@{
    ViewData["Title"] = "Forward numbers";
}

<section class="nova-page-head" aria-label="Page heading">
    <div class="nova-heading-group">
        <span class="nova-heading-icon" aria-hidden="true"><i class="fa fa-exchange"></i></span>
        <div class="nova-heading-copy">
            <span class="nova-eyebrow">NUMBER DIRECTORY</span>
            <h1>Forward numbers</h1>
            <p>Manage destination numbers for forwarding</p>
        </div>
    </div>
    <div class="nova-page-actions">
        <a asp-action="IncomingLogs" asp-controller="Sms" class="btn btn-outline-secondary btn-sm sg-secondary-action">
        <i class="fa fa-arrow-left me-1"></i> Back to SMS Logs
    </a>
        <a asp-action="Create" class="sg-create-button signal-create-link sg-primary-action">Add New</a>
    </div>
</section>


<section class="nova-list-card" aria-label="All Forward numbers">
    <div class="nova-list-toolbar">
        <div class="nova-list-heading"><span class="nova-list-heading-icon" aria-hidden="true"><i class="fa fa-list-ul"></i></span><div><h2>All Forward numbers</h2><p>Manage destination numbers for forwarding</p></div></div>
        <div class="nova-list-controls"><label class="nova-search" for="search-novaForwardNumTable"><i class="fa fa-search" aria-hidden="true"></i><span class="sr-only">Search All Forward numbers</span><input type="search" id="search-novaForwardNumTable" data-nova-search="novaForwardNumTable" placeholder="Search records..." autocomplete="off" /></label></div>
    </div>
    <div class="nova-table-viewport">
<table id="novaForwardNumTable" class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Number)
            </th>
            @*       <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.createdOn)
            </th>*@
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Number)
                </td>
                @*      <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.createdOn)
            </td>*@
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="sg-table-link sg-table-link-edit">Edit</a> |
                    @*  <a asp-action="Details" asp-route-id="@item.Id">Details</a> |*@
                    <a asp-action="Delete" asp-route-id="@item.Id" class="sg-table-link sg-table-link-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
</section>
