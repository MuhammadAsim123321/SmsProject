@{
    ViewData["Title"] = "IncomingLogs";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.1/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.datatables.net/1.12.1/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<style>
    #tblRPM { width: 100% !important; border-collapse: collapse; }

    #tblRPM thead th {
        background-color: #70b3db;
        color: white;
        padding: 10px 8px;
        white-space: nowrap;
        border: 1px solid #5a9fc7;
        text-align: left;
    }

    #tblRPM tbody td {
        padding: 6px 8px;
        vertical-align: middle;
        border: 1px solid #dee2e6;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    #tblRPM tbody td:nth-child(3) {
        white-space: normal;
        word-break: break-word;
        min-width: 150px;
        max-width: 200px;
    }

    #tblRPM tbody tr:nth-child(odd)  { background-color: #fff; }
    #tblRPM tbody tr:nth-child(even) { background-color: #f2f2f2; }
    #tblRPM tbody tr:hover           { background-color: #e8f4fc; cursor: pointer; }

    div.dataTables_wrapper div.dataTables_length select {
        width: 70px !important;
        display: inline-block !important;
        border-radius: 4px !important;
        border: 1px solid #ced4da !important;
        padding: 2px 4px !important;
        height: auto !important;
        -webkit-appearance: menulist !important;
        appearance: menulist !important;
        background-image: none !important;
    }

    .dataTables_wrapper .dataTables_filter input {
        border-radius: 4px;
        border: 1px solid #ced4da;
        padding: 4px 8px;
    }

    .dataTables_scrollBody {
        overflow-x: auto !important;
    }

    .dataTables_wrapper {
        width: 100%;
    }

    #tblRPM_wrapper {
        width: 100%;
        overflow-x: hidden;
    }

    .action-btns { white-space: nowrap; }
    .action-btns .btn { font-size: 0.8rem; padding: 3px 10px; margin: 1px; }

    .active-job-tag {
        background-color: #e9ecef;
        border: 1px solid #ced4da;
        color: #495057;
        border-radius: 20px;
        padding: 5px 12px;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 5px;
        margin-right: 5px;
    }

    .active-job-tag i { color: #dc3545; cursor: pointer; transition: 0.2s; }
    .active-job-tag i:hover { transform: scale(1.2); }

    footer.border-top { margin-top: 40px; padding: 16px 0; color: #888; font-size: 0.85rem; }

    .page-wrapper { transition: margin-left 0.3s ease; }
</style>

<div class="sg-sms-log-page">
    <section class="nova-page-head" aria-label="Page heading">
    <div class="nova-heading-group">
        <span class="nova-heading-icon" aria-hidden="true"><i class="fa fa-inbox"></i></span>
        <div class="nova-heading-copy">
            <span class="nova-eyebrow">MESSAGE INBOX</span>
            <h1>Incoming SMS</h1>
            <p>Review inbound messages, contact details and follow-up actions</p>
        </div>
    </div>
    
</section>

    @if (TempData["SucSms"] != null) { <div class="alert alert-success"><b>@TempData["SucSms"]</b></div> }
    @if (TempData["SucMsg"] != null) { <div class="alert alert-success"><b>@TempData["SucMsg"]</b></div> }
    @if (TempData["ErrMsg"] != null) { <div class="alert alert-danger"><b>@TempData["ErrMsg"]</b></div> }

    @* Response-time color legend *@
    <div class="sg-response-legend">
        <strong>Waiting Time Key:</strong>
        <span style="display:inline-flex;align-items:center;gap:6px;">
            <span style="width:14px;height:14px;background:#B8860B;border-radius:3px;display:inline-block;border:1px solid #ccc;"></span>Gold — 10–14 min 59 sec
        </span>
        <span style="display:inline-flex;align-items:center;gap:6px;">
            <span style="width:14px;height:14px;background:#b35a00;border-radius:3px;display:inline-block;border:1px solid #ccc;"></span>Orange — 15–19 min 59 sec
        </span>
        <span style="display:inline-flex;align-items:center;gap:6px;">
            <span style="width:14px;height:14px;background:#cc0000;border-radius:3px;display:inline-block;border:1px solid #ccc;"></span>Red — 20 min or more
        </span>
    </div>

    <div class="nova-list-card nova-inbox-card sg-fix-inbox"><div class="nova-list-toolbar"><div class="nova-list-heading"><span class="nova-list-heading-icon"><i class="fa fa-comments-o" aria-hidden="true"></i></span><div><h2>Message inbox</h2><p>Search, review and manage received messages</p></div></div><div class="nova-list-controls"><span class="nova-table-hint"><i class="fa fa-sliders" aria-hidden="true"></i> Use filters below</span></div></div><div class="sg-sms-table-zone">
    <table class="table table-bordered table-striped" id="tblRPM">
        <thead>
            <tr>
                <th>From</th>
                <th>Body</th>
                <th>Media</th>
                <th>Direction</th>
                <th>Name</th>
                <th>Street Address</th>
                <th>City/State</th>
                <th>ZIP Code</th>
                <th>Email</th>
                <th>Category</th>
                <th>Scheduler</th>
                <th>Job Booked Date</th>
                <th>Job Booked Time</th>
                <th>Incoming Date</th>
                <th>Incoming Time</th>
                <th>Responded Date</th>
                <th>Responded Time</th>
                <th>Waiting Time</th>
                <th></th>
            </tr>
        </thead>
    </table>
    </div>
</div>

    @await Html.PartialAsync("_IncomingEditModal")

    <div class="modal fade" id="deleteRangeModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Select Deletion Range</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="mb-3"><label>From Date</label><input type="date" id="dFromDate" class="form-control" /></div>
                    <div class="mb-3"><label>To Date</label><input type="date" id="dToDate" class="form-control" /></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btnShowConfirm" class="btn btn-danger">Continue</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="confirmModal" tabindex="-1" style="z-index:1060;">
        <div class="modal-dialog modal-sm">
            <div class="modal-content border-danger">
                <div class="modal-body text-center">
                    <h5>Are you sure?</h5>
                    <p>This will permanently delete records for the selected range.</p>
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">No, Cancel</button>
                    <button type="button" id="btnFinalDelete" class="btn btn-danger btn-sm">Yes, Delete</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="resultModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title" id="resultTitle">Notification</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body text-center" id="resultBody"></div>
                <div class="modal-footer"><button type="button" class="btn btn-primary btn-sm" data-bs-dismiss="modal">OK</button></div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="downloadRangeModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Select Download Range</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <form method="post" action="/Sms/DownloadLogsByDate">
                    <div class="modal-body">
                        <div class="mb-3"><label>From Date</label><input type="date" name="fromDate" class="form-control" required /></div>
                        <div class="mb-3"><label>To Date</label><input type="date" name="toDate" class="form-control" required /></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Download</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.1/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.12.1/js/dataTables.bootstrap5.min.js"></script>

<script>

    function formatFiveItems(data) {
        if (data && data !== "N/A" && typeof data === 'string') {
            var items = data.split(',').map(function (i) { return i.trim(); });
            var showText = items.length > 5 ? items.slice(0, 5).join(', ') + ' ...' : items.join(', ');
            return '<span title="' + data + '" style="cursor:help; text-decoration:underline dotted #70b3db 2px; text-underline-offset:4px;">' + showText + '</span>';
        }
        return data;
    }

    var RpmDatatable = $('#tblRPM').DataTable({
        "autoWidth": false,
        "scrollX": true,
        "sAjaxSource": "/SMS/GetData",
        "sServerMethod": "POST",
        "bServerSide": false,
        "bProcessing": true,
        "order": [],
        "columnDefs": [
            { "width": "110px", "targets": 0 },   // From
            { "width": "200px", "targets": 1 },   // Body
            { "width": "50px",  "targets": 2 },   // Media
            { "width": "70px",  "targets": 3 },   // Direction
            { "width": "80px",  "targets": 4 },   // Name
            { "width": "80px",  "targets": 5 },   // Street Address
            { "width": "100px", "targets": 6 },   // City/State
            { "width": "80px",  "targets": 7 },   // ZIP Code
            { "width": "120px", "targets": 8 },   // Email
            { "width": "60px",  "targets": 9 },   // Category
            { "width": "70px",  "targets": 10 },  // Scheduler
            { "width": "90px",  "targets": 11 },  // Job Booked Date
            { "width": "100px", "targets": 12 },  // Job Booked Time
            { "width": "100px", "targets": 13 },  // Incoming Date
            { "width": "100px", "targets": 14 },  // Incoming Time
            { "width": "100px", "targets": 15 },  // Responded Date
            { "width": "100px", "targets": 16 },  // Responded Time
            { "width": "90px",  "targets": 17 },  // Waiting Time
            { "width": "195px", "targets": 18, "orderable": false }  // Actions
        ],
        "language": {
            "emptyTable": "No record found.",
            "processing": '<i class="fa fa-spinner fa-spin fa-3x fa-fw"></i>'
        },
        // Task 4: color incoming rows based on waiting time — text only, no background change
        "createdRow": function (row, data) {
            if (data.smsDirection === "Incoming" && data.waitingColor) {
                var textColorMap = { gold: '#B8860B', orange: '#b35a00', red: '#cc0000' };
                var color = textColorMap[data.waitingColor];
                if (color) {
                    $('td', row).css({ 'color': color, 'font-weight': '600' });
                }
            }
        },
        "initComplete": function () {
            $.get("/SMS/GetIvrOptions", function (data) {
                var ddl = $("#mCategory");
                ddl.find('option:not(:first)').remove();
                $.each(data, function (i, item) {
                    ddl.append($("<option></option>").val(item.id).html(item.keyword));
                });
            });
            $.get("/Sms/GetSchedulers", function (data) {
                var ddl = $("#mSchedularTemplate");
                ddl.find('option:not(:first)').remove();
                $.each(data, function (i, item) {
                    ddl.append($("<option></option>")
                        .val(item.id)
                        .attr('data-runfromid',   item.runFromId  || '')
                        .attr('data-timetorunid', item.timeToRunId || '')
                        .attr('data-hourcount',   item.hourCount  || '')
                        .html(item.name));
                });
            });
        },
        "columns": [
            { "data": "fromNum",      "searchable": true },
            { "data": "smsBody",      "searchable": true },
            {
                "data": null,
                "defaultContent": "N/A",
                "searchable": false,
                "orderable": false,
                "render": function (data, type, row) {
                    if (row.attchmentsCount > 0) {
                        return '<button class="btn btn-sm btn-outline-dark" onclick="event.stopPropagation(); openAttachments(\'' + row.id + '\')">See attachments</button>';
                    }
                    return "N/A";
                }
            },
            { "data": "smsDirection",     "searchable": true },
            { "data": "name",             "searchable": true, "defaultContent": "N/A" },
            { "data": "streetAddress",    "searchable": true, "defaultContent": "N/A" },
            { "data": "cityState",        "searchable": true, "defaultContent": "N/A" },
            { "data": "zipCode",          "searchable": true, "defaultContent": "N/A" },
            { "data": "email",            "searchable": true, "defaultContent": "N/A" },
            { "data": "category",         "searchable": true, "defaultContent": "N/A", "render": formatFiveItems },
            { "data": "scheduler",        "searchable": true, "defaultContent": "N/A", "render": formatFiveItems },
            { "data": "jobBookDatesList", "searchable": true, "defaultContent": "N/A", "render": formatFiveItems },
            { "data": "jobBookTimesList", "searchable": true, "defaultContent": "N/A", "render": formatFiveItems },
            // Task 4: Response time columns (after Job Booked Time)
            {
                "data": "incomingDate",
                "searchable": true,
                "defaultContent": "",
                "render": function (data, type, row) {
                    return row.smsDirection === "Incoming" ? (data || "") : "";
                }
            },
            {
                "data": "incomingTime",
                "searchable": true,
                "defaultContent": "",
                "render": function (data, type, row) {
                    return row.smsDirection === "Incoming" ? (data || "") : "";
                }
            },
            {
                "data": "respondedDate",
                "searchable": true,
                "defaultContent": "",
                "render": function (data, type, row) {
                    return row.smsDirection === "Incoming" ? (data || "") : "";
                }
            },
            {
                "data": "respondedTime",
                "searchable": true,
                "defaultContent": "",
                "render": function (data, type, row) {
                    return row.smsDirection === "Incoming" ? (data || "") : "";
                }
            },
            {
                "data": "waitingDisplay",
                "searchable": false,
                "defaultContent": "",
                "render": function (data, type, row) {
                    if (row.smsDirection !== "Incoming") return "";
                    var colorMap = { gold: '#B8860B', orange: '#b35a00', red: '#cc0000' };
                    var color = colorMap[row.waitingColor] || '#555';
                    var weight = row.waitingColor ? 'bold' : 'normal';
                    return '<span style="color:' + color + '; font-weight:' + weight + ';">' + (data || "Pending") + '</span>';
                }
            },
            {
                "data": null,
                "searchable": false,
                "orderable": false,
                "render": function (data, type, row) {
                    return '<div class="action-btns">' +
                        '<button class="btn btn-sm btn-primary" onclick="event.stopPropagation(); EditRecord(\'' + (row.smsDirection === "Incoming" ? row.fromNum : row.toNum) + '\')">Reply</button>' +
                        '<button class="btn btn-sm btn-danger" onclick="event.stopPropagation(); DeleteRecord(' + row.id + ')">Delete</button>' +
                        '</div>';
                }
            }
        ]
    });

    $('#toggle_btn, #mobile_btn').on('click', function () {
        setTimeout(function () {
            RpmDatatable.columns.adjust();
        }, 320);
    });

    $(window).on('resize', function () {
        RpmDatatable.columns.adjust();
    });

    $('#tblRPM tbody').on('click', 'tr', function () {
        var data = RpmDatatable.row(this).data();
        if (!data) return;
        currentRowData = data;

        var isOutgoing = (data.smsDirection || "").indexOf("Outgoing") === 0;
        $('#mSmsDirection').val(data.smsDirection);
        $('#mFromNum').val(data.fromNum);
        $('#mOriginalFromNum').val(data.fromNum);
        $('#mOriginalToNum').val(data.toNum);
        $('#mSchedulerId').val(data.schedulerId || 0);

        $('#customDateFieldContainer').hide();
        $('#customDaysHoursContainer').hide();
        $('#mCustomDate').val('');
        $('#mCustomDays').val('');
        $('#mCustomHoursVal').val('');
        $('#mTechnician').val('');
        $('#mJobBookDate').val('');
        $('#mJobCompletedDate').val('');
        $('#technicianAvailabilityInfo').text('');
        window.assignedTechnicianId = null;
        window.currentCategoryId = null;

        if (isOutgoing) { 
            $('#jobScheduleSection').hide(); 
            $('#outgoingAlert').show(); 
            $('#technicianSection').hide();
        }
        else { 
            $('#jobScheduleSection').show(); 
            $('#outgoingAlert').hide();
            $('#technicianSection').show();
        }

        $.get("/Sms/GetContactDetailsByPhone", { phoneNumber: data.fromNum }, function (res) {
            $('#activeJobsContainer').empty();
            if (res.success && res.found) {
                $('#mName').val(res.name || "");
                $('#mEmail').val(res.email || "");
                $('#mStreetAddress').val(res.streetAddress || "");
                $('#mCityState').val(res.cityState || "");
                $('#mZipCode').val(res.zipCode || "");
                
                // Store values
                window.currentCustomerZip = res.zipCode || "";
                window.assignedTechnicianId = res.assignedTechnicianId || null;
                window.currentCategoryId = res.categoryId || null;
                
                console.log('Contact loaded:', {
                    technicianId: window.assignedTechnicianId,
                    categoryId: window.currentCategoryId,
                    zip: window.currentCustomerZip
                });
                
                // PRE-SELECT CATEGORY if it exists
                if (res.categoryId) {
                    $('#mCategory').val(res.categoryId);
                }
                
                // Show assigned technician indicator
                if (res.assignedTechnicianId && res.assignedTechnicianName) {
                    $('#currentTechnicianInfo').html(
                        '<i class="fa fa-check-circle text-success"></i> <strong style="color: #28a745;">Currently assigned to: ' + 
                        res.assignedTechnicianName + '</strong>'
                    );
                } else {
                    $('#currentTechnicianInfo').html('');
                }
                
                if (!isOutgoing && res.activeJobs && res.activeJobs.length > 0) {
                    res.activeJobs.forEach(function (job) {
                        $('#activeJobsContainer').append(
                            '<div class="active-job-tag">' + job.schedulerName +
                            '<i class="fa-solid fa-times-circle" onclick="removeActiveJob(' + job.jobId + ', this)"></i></div>'
                        );
                    });
                }
            } else {
                $('#mName').val(data.name === "N/A" ? "" : data.name);
                $('#mEmail').val(data.email === "N/A" ? "" : data.email);
                $('#mStreetAddress').val("");
                $('#mCityState').val("");
                $('#mZipCode').val("");
                window.currentCustomerZip = "";
                window.assignedTechnicianId = null;
                window.currentCategoryId = null;
            }
            
            $('#btnUpdate').prop('disabled', true);
            $('#editModal').modal('show');
            
            // Trigger category change to load technicians immediately after modal shows
            setTimeout(function() {
                var categoryId = $('#mCategory').val();
                if (categoryId) {
                    console.log('Calling handleCategoryChange with category:', categoryId);
                    handleCategoryChange();
                }
            }, 300);
        });
    });

    $('.m-input').on('input change', function () { $('#btnUpdate').prop('disabled', false); });

    $('#btnUpdate').click(function () {
        var days        = parseInt($('#mCustomDays').val())     || 0;
        var hrs         = parseInt($('#mCustomHoursVal').val()) || 0;
        var customHours = (days * 24) + hrs;

        var model = {
            fromNum:          $('#mOriginalFromNum').val(),
            smsDirection:     $('#mSmsDirection').val(),
            name:             $('#mName').val(),
            email:            $('#mEmail').val(),
            streetAddress:    $('#mStreetAddress').val(),
            cityState:        $('#mCityState').val(),
            zipCode:          $('#mZipCode').val(),
            category:         $('#mCategory').val(),
            schedulerId:      $('#mSchedularTemplate').val(),
            jobBookDate:      $('#mJobBookDate').val(),
            jobCompletedDate: $('#mJobCompletedDate').val(),
            customDate:       $('#mCustomDate').val(),
            customHours:      customHours > 0 ? customHours : null,
            technicianId:     $('#mTechnician').val()
        };
        var $btn = $(this);
        $btn.prop('disabled', true);
        $.post("/SMS/UpdateSmsDetails", model, function (res) {
            $btn.prop('disabled', false);
            if (res.success) {
                $('#editModal').modal('hide');
                showResult("Success", res.isOutgoing ? (res.message || "Contact updated.") : "Details updated successfully.", "text-success");
                RpmDatatable.ajax.reload(null, false);
            } else {
                showResult("Update Failed", res.message || "Unknown error.", "text-danger");
            }
        });
    });

    function handleTemplateChange() {
        var selectedOption = $('#mSchedularTemplate option:selected');
        var runFromId  = parseInt(selectedOption.attr('data-runfromid'),  10);
        var hourCount  = parseInt(selectedOption.attr('data-hourcount'),  10);

        if (runFromId === 2) { $('#customDateFieldContainer').show(); }
        else { $('#customDateFieldContainer').hide(); $('#mCustomDate').val(''); }

        if (hourCount === -1) { $('#customDaysHoursContainer').show(); }
        else { $('#customDaysHoursContainer').hide(); $('#mCustomDays').val(''); $('#mCustomHoursVal').val(''); }
    }

    function removeActiveJob(jobId, element) {
        if (confirm("Remove this scheduler?")) {
            $.post("/Sms/DeleteScheduledJob", { jobId: jobId }, function (res) {
                if (res.success) { $(element).parent().fadeOut(); RpmDatatable.ajax.reload(null, false); }
                else { alert("Error removing job."); }
            });
        }
    }

    $('#btnShowConfirm').click(function () {
        if (!$('#dFromDate').val() || !$('#dToDate').val()) {
            showResult("Missing Info", "Please select both dates.", "text-warning"); return;
        }
        $('#confirmModal').modal('show');
    });

    $('#btnFinalDelete').click(function () {
        $('#confirmModal').modal('hide');
        $.post("/SMS/DeleteLogsByDate", { fromDate: $('#dFromDate').val(), toDate: $('#dToDate').val() }, function (res) {
            if (res.success) {
                $('#deleteRangeModal').modal('hide');
                showResult("Success", res.count + " records deleted.", "text-success");
                RpmDatatable.ajax.reload();
            } else {
                showResult("Error", res.message, "text-danger");
            }
        });
    });

    function showResult(title, msg, colorClass) {
        $('#resultTitle').text(title).removeClass("text-success text-danger text-warning").addClass(colorClass);
        $('#resultBody').text(msg);
        $('#resultModal').modal('show');
    }

    function handleCategoryChange() {
        var previousTech = $('#mTechnician').val();
        var categoryId = $('#mCategory').val();
        var customerZip = ($('#mZipCode').val() || '').trim();
        var jobDate = $('#mJobBookDate').val();   // "2026-10-23T10:00" or ""
        window.currentCategoryId = categoryId;

        if (!categoryId) { $('#mTechnician').html('<option value="">-- Select Category First --</option>'); showTechnicianHint(); return; }
        if (!customerZip) { $('#mTechnician').html('<option value="">-- Enter customer ZIP first --</option>'); showTechnicianHint(); return; }

        $('#mTechnician').html('<option value="">Loading technicians...</option>');

        var query = { customerZip: customerZip, categoryId: categoryId };
        if (jobDate) query.jobDateTime = jobDate;

        $.get('/Technicians/GetFilteredTechnicians', query, function (technicians) {
            var $ddl = $('#mTechnician').empty();
            if (!Array.isArray(technicians)) { $ddl.append('<option value="">Error loading technicians</option>'); return; }
            if (technicians.length === 0) { $ddl.append('<option value="">No technicians for this category</option>'); return; }

            $ddl.append('<option value="">-- Select a Technician --</option>');
            technicians.forEach(function (t) {
                var text = t.label + (t.isAvailable ? '' : ' - NOT available at selected time');
                $('<option></option>').val(t.id).text(text)
                    .attr('data-summary', t.availabilitySummary || '')
                    .attr('data-available', t.isAvailable ? '1' : '0')
                    .attr('data-message', t.availabilityMessage || '')
                    .appendTo($ddl);
            });

            var keep = previousTech || window.assignedTechnicianId;
            if (keep) $ddl.val(keep);
            showTechnicianHint();
        });
    }
    function showTechnicianHint() {
        var $opt = $('#mTechnician option:selected');
        var $info = $('#technicianAvailabilityInfo');
        if (!$opt.val()) { $info.text('').removeClass('text-danger text-muted'); return; }

        var text = 'Working hours: ' + ($opt.attr('data-summary') || 'Not configured');
        if ($opt.attr('data-available') === '0') {
            text += ' | ' + ($opt.attr('data-message') || 'Not available at the selected time.');
            $info.text(text).removeClass('text-muted').addClass('text-danger');
        } else {
            $info.text(text).removeClass('text-danger').addClass('text-muted');
        }
    }

    $('#mTechnician').on('change', showTechnicianHint);
    $('#mJobBookDate').on('change', handleCategoryChange);  // re-check availability for the new date/time
    $('#mZipCode').on('change', handleCategoryChange);      // reload when ZIP is edited

    // NEW: Assign technician button handler
    $('#btnAssignTechnician').click(function() {
        var technicianId = $('#mTechnician').val();
        var phoneNumber = $('#mFromNum').val();
        
        if (!technicianId) {
            alert('Please select a technician first.');
            return;
        }
        
        var $btn = $(this);
        $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Assigning...');
        
        $.post('/Sms/AssignTechnician', { 
            phoneNumber: phoneNumber, 
            technicianId: technicianId 
        }, function(res) {
            $btn.prop('disabled', false).html('<i class="fa fa-user-check"></i> Assign');
            
            if (res.success) {
                $('#currentTechnicianInfo').html(
                    '<i class="fa fa-check-circle text-success"></i> Currently assigned to: <strong>' + 
                    res.technicianName + '</strong>'
                );
                showResult("Success", res.message, "text-success");
            } else {
                alert('Error: ' + res.message);
            }
        });
    });

    function openAttachments(id) { window.open("@Url.Action("OpenAttachments", "Sms")?id=" + id, '_blank'); }
    function EditRecord(num)     { window.location.href = '@Url.Action("SMS", "Conversations")?num=' + num; }
    function DeleteRecord(id) {
        $.post('/Sms/DeleteMsg', { id: id }, function (response) {
            if (response == "success") {
                RpmDatatable.row(function (idx, data) { return data.id === id; }).remove().draw(false);
            }
        });
    }

</script>
