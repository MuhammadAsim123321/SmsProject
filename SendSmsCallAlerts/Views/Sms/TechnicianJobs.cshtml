@{
    ViewData["Title"] = "Technician Scheduled Jobs";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.1/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.datatables.net/1.12.1/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<style>
    /* ---- Page layout ---- */
    .tj-page-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        padding: 28px;
        margin: 20px;
    }

    /* ---- Filters bar ---- */
    .tj-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: flex-end;
        margin-bottom: 20px;
        padding: 16px;
        background: #f8fbff;
        border: 1px solid #dbe7f1;
        border-radius: 10px;
    }

    .tj-filters label {
        font-size: 0.82rem;
        font-weight: 600;
        color: #4a6785;
        margin-bottom: 4px;
        display: block;
    }

    .tj-filters .form-control,
    .tj-filters .form-select {
        font-size: 0.88rem;
        border-radius: 8px;
    }

    /* ---- Stats ---- */
    .tj-stat-card {
        border-radius: 10px;
        padding: 14px 18px;
        text-align: center;
    }

    .tj-stat-number {
        font-size: 1.6rem;
        font-weight: 700;
    }

    .tj-stat-label {
        font-size: 0.78rem;
        color: #64748b;
        margin-top: 2px;
    }

    /* ---- Table ---- */
    #tblTechJobs {
        width: 100% !important;
        border-collapse: collapse;
    }

    #tblTechJobs thead th {
        background-color: #70b3db;
        color: white;
        text-align: center;
        padding: 12px 10px;
        white-space: nowrap;
        border: none;
        font-size: 0.85rem;
    }

    #tblTechJobs tbody td {
        padding: 10px 12px;
        vertical-align: middle;
        border-bottom: 1px solid #f0f0f0;
        font-size: 0.88rem;
    }

    #tblTechJobs tbody tr:hover { background-color: #f7fbff; }
    #tblTechJobs tbody tr:nth-child(even) { background-color: #fafafa; }

    /* Technician group header row */
    .tj-tech-group-row td {
        background: #eef6fb !important;
        padding: 8px 12px !important;
        border-top: 2px solid #70b3db !important;
        border-bottom: 1px solid #c9e0f0 !important;
    }

    /* ---- Status badges ---- */
    .tj-status {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        white-space: nowrap;
    }
    .tj-status-scheduled  { background: #dbeafe; color: #1e40af; }
    .tj-status-confirmed  { background: #dcfce7; color: #166534; }
    .tj-status-cancelled  { background: #fee2e2; color: #991b1b; }
    .tj-status-completed  { background: #f3f4f6; color: #374151; }

    /* ---- Misc ---- */
    .tj-amount       { font-weight: 600; color: #16a34a; }
    .tj-amount-empty { color: #94a3b8; font-style: italic; font-size: 0.82rem; }
    .tj-job-id       { font-weight: 700; color: #70b3db; font-size: 0.9rem; }
    .tj-phone        { white-space: nowrap; }
    .tj-dist {
        font-size: 0.8rem;
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        padding: 2px 8px;
        white-space: nowrap;
    }

    /* DataTables tweaks */
    .dataTables_wrapper .dataTables_filter input {
        border-radius: 8px; border: 1px solid #ddd; padding: 4px 10px;
    }
    .dataTables_wrapper .dataTables_length select {
        border-radius: 8px; border: 1px solid #ddd; padding: 3px 8px;
    }
    div.dataTables_wrapper div.dataTables_paginate ul.pagination { margin-top: 10px; }

    .tj-page-title    { font-size: 1.6rem; font-weight: 700; color: #2c3e50; margin-bottom: 4px; }
    .tj-page-subtitle { color: #888; font-size: 0.9rem; margin-bottom: 20px; }
</style>

<div class="tj-page-card">

    @* Page heading *@
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
        <div>
            <span style="font-size:0.7rem; letter-spacing:.1em; text-transform:uppercase; color:#70b3db; font-weight:700;">OPERATIONS</span>
            <h1 class="tj-page-title"><i class="fa fa-hard-hat me-2" aria-hidden="true"></i>Technician Scheduled Jobs</h1>
            <p class="tj-page-subtitle">All jobs sorted by technician — customer info, quoted amount and timing at a glance.</p>
        </div>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <button id="btnExportCsv" class="btn btn-outline-secondary btn-sm" style="border-radius:8px;">
                <i class="fa fa-download me-1"></i>Export CSV
            </button>
            <a asp-action="IncomingLogs" asp-controller="Sms" class="btn btn-secondary btn-sm">
                <i class="fa fa-arrow-left me-1"></i>Back to SMS Logs
            </a>
        </div>
    </div>

    @* Stats row *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="tj-stat-card" style="background:#eff6ff; border:1px solid #bfdbfe;">
                <div class="tj-stat-number" style="color:#1d4ed8;" id="statTotal">—</div>
                <div class="tj-stat-label">Total Jobs</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="tj-stat-card" style="background:#f0fdf4; border:1px solid #bbf7d0;">
                <div class="tj-stat-number" style="color:#16a34a;" id="statScheduled">—</div>
                <div class="tj-stat-label">Scheduled / Confirmed</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="tj-stat-card" style="background:#fffbeb; border:1px solid #fde68a;">
                <div class="tj-stat-number" style="color:#d97706;" id="statCompleted">—</div>
                <div class="tj-stat-label">Completed</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="tj-stat-card" style="background:#fef2f2; border:1px solid #fecaca;">
                <div class="tj-stat-number" style="color:#dc2626;" id="statCancelled">—</div>
                <div class="tj-stat-label">Cancelled</div>
            </div>
        </div>
    </div>

    @* Filters *@
    <div class="tj-filters">
        <div>
            <label for="filterStatus">Status</label>
            <select id="filterStatus" class="form-select form-select-sm" style="min-width:160px;">
                <option value="All">All Statuses</option>
                <option value="Scheduled">Scheduled</option>
                <option value="Confirmed">Confirmed</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
            </select>
        </div>
        <div>
            <label for="filterDateFrom">Date From</label>
            <input type="date" id="filterDateFrom" class="form-control form-control-sm" style="min-width:150px;" />
        </div>
        <div>
            <label for="filterDateTo">Date To</label>
            <input type="date" id="filterDateTo" class="form-control form-control-sm" style="min-width:150px;" />
        </div>
        <div class="d-flex gap-2">
            <button id="btnApplyFilter" class="btn btn-primary btn-sm" style="border-radius:8px;">
                <i class="fa fa-filter me-1"></i>Apply
            </button>
            <button id="btnClearFilter" class="btn btn-outline-secondary btn-sm" style="border-radius:8px;">
                <i class="fa fa-times me-1"></i>Clear
            </button>
        </div>
    </div>

    @* Table *@
    <div style="overflow-x:auto;">
        <table id="tblTechJobs" class="table" aria-label="Technician scheduled jobs">
            <thead>
                <tr>
                    <th>Job Order #</th>
                    <th>Technician</th>
                    <th>Customer Name</th>
                    <th>Phone #</th>
                    <th>Address</th>
                    <th>Distance</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Time of Job</th>
                    <th>Quoted Amount</th>
                    <th>Status</th>
                </tr>
            </thead>
        </table>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.12.1/js/dataTables.bootstrap5.min.js"></script>

    <script>
        (function () {
            var table;
            var currentParams = { status: 'All', dateFrom: '', dateTo: '' };

            function esc(s) { return $('<div>').text(s == null ? '' : String(s)).html(); }
            function csvEsc(v) {
                if (v == null) return '';
                var s = String(v).replace(/"/g, '""');
                return /[",\r\n]/.test(s) ? '"' + s + '"' : s;
            }

            // ---- Build / reload the DataTable ----
            function loadTable(params) {
                var url = '/Sms/GetTechnicianJobsData'
                    + '?status='   + encodeURIComponent(params.status   || 'All')
                    + '&dateFrom=' + encodeURIComponent(params.dateFrom || '')
                    + '&dateTo='   + encodeURIComponent(params.dateTo   || '');

                if (table) {
                    table.destroy();
                    $('#tblTechJobs thead tr').html(
                        '<th>Job Order #</th><th>Technician</th><th>Customer Name</th>' +
                        '<th>Phone #</th><th>Address</th><th>Distance</th>' +
                        '<th>Category</th><th>Date</th><th>Time of Job</th>' +
                        '<th>Quoted Amount</th><th>Status</th>');
                }

                table = $('#tblTechJobs').DataTable({
                    ajax: {
                        url: url,
                        type: 'GET',
                        dataSrc: function (json) {
                            if (json.error) { alert('Error: ' + json.error); return []; }
                            updateStats(json.aaData || []);
                            return json.aaData || [];
                        }
                    },
                    processing: true,
                    scrollX: true,
                    // Sort by technician name first, then date
                    order: [[1, 'asc'], [7, 'asc']],
                    language: {
                        emptyTable: 'No jobs found.',
                        processing: '<div class="text-center py-3"><i class="fa fa-spinner fa-spin fa-2x" style="color:#70b3db;"></i></div>'
                    },
                    columns: [
                        // 0: Job Order #
                        {
                            data: 'jobId', width: '90px',
                            render: function (d) {
                                return '<span class="tj-job-id">#' + d + '</span>';
                            }
                        },
                        // 1: Technician
                        {
                            data: 'technicianName',
                            render: function (d) {
                                return '<span style="font-weight:600;">' + esc(d) + '</span>';
                            }
                        },
                        // 2: Customer Name
                        { data: 'customerName', render: function (d) { return esc(d); } },
                        // 3: Phone #
                        {
                            data: 'phoneNumber', className: 'tj-phone',
                            render: function (d) {
                                if (!d || d === 'N/A') return 'N/A';
                                return '<a href="tel:' + esc(d) + '" style="white-space:nowrap;">' + esc(d) + '</a>';
                            }
                        },
                        // 4: Address
                        { data: 'address', render: function (d) { return esc(d || 'N/A'); } },
                        // 5: Distance
                        {
                            data: 'distanceMiles',
                            render: function (d, type, row) {
                                if (type === 'sort') return row.distanceRaw != null ? row.distanceRaw : 99999;
                                if (!d || d === 'N/A') return '<span class="tj-amount-empty">N/A</span>';
                                return '<span class="tj-dist"><i class="fa fa-route me-1"></i>' + esc(d) + '</span>';
                            }
                        },
                        // 6: Category
                        { data: 'category', render: function (d) { return esc(d || 'N/A'); } },
                        // 7: Date (sortable as a date string MM/dd/yyyy)
                        {
                            data: 'startDate',
                            render: function (d, type) {
                                if (type === 'sort') {
                                    // Convert MM/dd/yyyy to yyyyMMdd for correct numeric sort
                                    if (!d) return '00000000';
                                    var p = d.split('/');
                                    return (p[2] || '0000') + (p[0] || '00') + (p[1] || '00');
                                }
                                return esc(d || '—');
                            }
                        },
                        // 8: Time of Job
                        {
                            data: 'startTime', orderable: false,
                            render: function (d, type, row) {
                                return '<span style="white-space:nowrap;">' + esc(d) + ' &ndash; ' + esc(row.endAt) + '</span>';
                            }
                        },
                        // 9: Quoted Amount
                        {
                            data: 'quotedAmount',
                            render: function (d, type) {
                                if (type === 'sort') return (d !== '' && d != null) ? parseFloat(d) : -1;
                                if (d === '' || d == null)
                                    return '<span class="tj-amount-empty">Not set</span>';
                                return '<span class="tj-amount">$' + esc(d) + '</span>';
                            }
                        },
                        // 10: Status
                        {
                            data: 'effectiveStatus',
                            render: function (d) {
                                var icons = { 'Scheduled': 'fa-calendar', 'Confirmed': 'fa-check-circle', 'Completed': 'fa-flag-checkered', 'Cancelled': 'fa-ban' };
                                var cls  = 'tj-status tj-status-' + (d || '').toLowerCase();
                                var icon = icons[d] || 'fa-circle';
                                return '<span class="' + cls + '"><i class="fa ' + icon + ' me-1"></i>' + esc(d) + '</span>';
                            }
                        }
                    ],
                    drawCallback: function () {
                        // Insert technician group-header rows between technician blocks
                        var api = this.api();
                        var lastTech = null;
                        var domRows = api.rows({ page: 'current' }).nodes();
                        api.rows({ page: 'current' }).data().each(function (row, i) {
                            var tech = row.technicianName;
                            if (tech !== lastTech) {
                                var icon = (tech === 'Unassigned')
                                    ? '<i class="fa fa-question-circle me-2 text-muted"></i>'
                                    : '<i class="fa fa-hard-hat me-2" style="color:#70b3db;"></i>';
                                $('<tr class="tj-tech-group-row"><td colspan="11" style="font-weight:700; color:#2c5b7a; font-size:0.95rem;">'
                                    + icon + esc(tech) + '</td></tr>').insertBefore(domRows[i]);
                                lastTech = tech;
                            }
                        });
                    }
                });
            }

            // ---- Stats ----
            function updateStats(data) {
                $('#statTotal').text(data.length);
                $('#statScheduled').text(data.filter(function (r) {
                    return r.effectiveStatus === 'Scheduled' || r.effectiveStatus === 'Confirmed';
                }).length);
                $('#statCompleted').text(data.filter(function (r) { return r.effectiveStatus === 'Completed'; }).length);
                $('#statCancelled').text(data.filter(function (r) { return r.effectiveStatus === 'Cancelled'; }).length);
            }

            // ---- Filters ----
            $('#btnApplyFilter').on('click', function () {
                currentParams = {
                    status:   $('#filterStatus').val(),
                    dateFrom: $('#filterDateFrom').val(),
                    dateTo:   $('#filterDateTo').val()
                };
                loadTable(currentParams);
            });

            $('#btnClearFilter').on('click', function () {
                $('#filterStatus').val('All');
                $('#filterDateFrom').val('');
                $('#filterDateTo').val('');
                currentParams = { status: 'All', dateFrom: '', dateTo: '' };
                loadTable(currentParams);
            });

            // ---- CSV Export (respects current search/filter) ----
            $('#btnExportCsv').on('click', function () {
                if (!table) return;
                var rows = table.rows({ search: 'applied' }).data().toArray();
                var headers = ['Job Order #', 'Technician', 'Customer Name', 'Phone #', 'Address', 'Distance (mi)', 'Category', 'Date', 'Time', 'Quoted Amount', 'Status'];
                var lines = [headers.join(',')];
                rows.forEach(function (r) {
                    lines.push([
                        r.jobId,
                        csvEsc(r.technicianName),
                        csvEsc(r.customerName),
                        csvEsc(r.phoneNumber),
                        csvEsc(r.address),
                        csvEsc(r.distanceMiles),
                        csvEsc(r.category),
                        csvEsc(r.startDate),
                        csvEsc(r.startTime + ' - ' + r.endAt),
                        r.quotedAmount !== '' && r.quotedAmount != null ? '$' + r.quotedAmount : '',
                        csvEsc(r.effectiveStatus)
                    ].join(','));
                });
                var blob = new Blob([lines.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
                var link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = 'TechnicianJobs_' + new Date().toISOString().slice(0, 10) + '.csv';
                link.click();
            });

            // ---- Initial load ----
            loadTable(currentParams);

        })();
    </script>
}
