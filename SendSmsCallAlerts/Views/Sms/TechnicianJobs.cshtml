@{
    ViewData["Title"] = "Technician Jobs";
}

<link href="https://cdn.datatables.net/1.12.1/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<section class="nova-page-head" aria-label="Page heading">
    <div class="nova-heading-group">
        <span class="nova-heading-icon" aria-hidden="true"><i class="fa fa-hard-hat"></i></span>
        <div class="nova-heading-copy">
            <span class="nova-eyebrow">OPERATIONS</span>
            <h1>Technician Jobs</h1>
            <p>All jobs sorted by technician — customer info, quoted amount and timing</p>
        </div>
    </div>
    <div class="nova-page-actions">
        <button id="btnExportCsv" class="btn btn-outline-secondary btn-sm">
            <i class="fa fa-download me-1"></i> Export CSV
        </button>
        <a asp-action="IncomingLogs" asp-controller="Sms" class="btn btn-secondary btn-sm">
            <i class="fa fa-arrow-left me-1"></i> Back to SMS Logs
        </a>
    </div>
</section>

@* Stats row *@
<div class="nova-stat-row tj-page">
    <div class="nova-stat-card nova-stat--total">
        <div class="nova-stat-number" id="statTotal">—</div>
        <div class="nova-stat-label">Total Jobs</div>
    </div>
    <div class="nova-stat-card nova-stat--scheduled">
        <div class="nova-stat-number" id="statScheduled">—</div>
        <div class="nova-stat-label">Scheduled / Confirmed</div>
    </div>
    <div class="nova-stat-card nova-stat--completed">
        <div class="nova-stat-number" id="statCompleted">—</div>
        <div class="nova-stat-label">Completed</div>
    </div>
    <div class="nova-stat-card nova-stat--cancelled">
        <div class="nova-stat-number" id="statCancelled">—</div>
        <div class="nova-stat-label">Cancelled</div>
    </div>
</div>

@* List card with toolbar *@
<section class="nova-list-card sg-fix-tech-jobs tj-page" aria-label="Technician scheduled jobs">
    <div class="nova-list-toolbar">
        <div class="nova-list-heading">
            <span class="nova-list-heading-icon" aria-hidden="true"><i class="fa fa-calendar-o"></i></span>
            <div>
                <h2>Jobs List</h2>
                <p>Filter by status, date range, or technician</p>
            </div>
        </div>
    </div>

    @* Filters *@
    <div class="nova-filter-bar">
        <div class="nova-filter-group">
            <label for="filterStatus" class="nova-filter-label">Status</label>
            <select id="filterStatus" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="Scheduled">Scheduled</option>
                <option value="Confirmed">Confirmed</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
            </select>
        </div>
        <div class="nova-filter-group">
            <label for="filterTechnician" class="nova-filter-label">Technician</label>
            <select id="filterTechnician" class="form-select form-select-sm">
                <option value="">All Technicians</option>
            </select>
        </div>
        <div class="nova-filter-group">
            <label for="filterDateFrom" class="nova-filter-label">Date From</label>
            <input type="date" id="filterDateFrom" class="form-control form-control-sm" />
        </div>
        <div class="nova-filter-group">
            <label for="filterDateTo" class="nova-filter-label">Date To</label>
            <input type="date" id="filterDateTo" class="form-control form-control-sm" />
        </div>
        <div class="nova-filter-actions">
            <button id="btnApplyFilter" class="btn btn-primary btn-sm">
                <i class="fa fa-filter me-1"></i> Apply
            </button>
            <button id="btnClearFilter" class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-times me-1"></i> Clear
            </button>
        </div>
    </div>

    @* Table *@
    <!-- ROUND 5: Reverted fixed-width layout, using overflow-x auto for horizontal scroll -->
    <div class="nova-table-viewport" style="overflow-x: auto; width: 100%;">
        <!-- COMMENTED OUT (Round 4): table-layout:fixed;width:100%; -->
        <!-- COMMENTED OUT (Round 4): <colgroup> with percentage widths -->
        <table id="tblTechJobs" class="table table-bordered table-striped" aria-label="Technician scheduled jobs">
            <!-- COMMENTED OUT Round 4 colgroup: Column widths (sum 100%): Technician 10% | Time 7% | Order# 6% | Customer 11% | Street 16% | City/State 11% | ZIP 6% | Distance 9% | Phone 10% | Quoted 7% | Status 7% -->
            <!--
            <colgroup>
                <col style="width:10%;">
                <col style="width:7%;">
                <col style="width:6%;">
                <col style="width:11%;">
                <col style="width:16%;">
                <col style="width:11%;">
                <col style="width:6%;">
                <col style="width:9%;">
                <col style="width:10%;">
                <col style="width:7%;">
                <col style="width:7%;">
            </colgroup>
            -->
            <thead>
                <tr>
                    <th>Technician</th>
                    <th>Time</th>
                    <th>Order #</th>
                    <th>Customer</th>
                    <th>Street</th>
                    <!-- OLD: <th>City</th><th>State</th> -->
                    <th>City / State</th>
                    <th>ZIP</th>
                    <th>Distance</th>
                    <th>Phone</th>
                    <th>Quoted</th>
                    <th>Status</th>
                </tr>
            </thead>
        </table>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.12.1/js/dataTables.bootstrap5.min.js"></script>

    <script>
        (function () {
            var table;
            var allTechnicians = [];
            var currentParams = { status: '', technician: '', dateFrom: '', dateTo: '' };

            function esc(s) { return $('<div>').text(s == null ? '' : String(s)).html(); }
            function csvEsc(v) {
                if (v == null) return '';
                var s = String(v).replace(/"/g, '""');
                return /[",\r\n]/.test(s) ? '"' + s + '"' : s;
            }

            // Parse CityState into City and State
            /* COMMENTED OUT: No longer needed - City/State is combined in one column */
            /*
            function parseCity(cityState) {
                if (!cityState) return '';
                var parts = cityState.split(',').map(function(p) { return p.trim(); });
                return parts.length > 0 ? parts[0] : '';
            }

            function parseState(cityState) {
                if (!cityState) return '';
                var parts = cityState.split(',').map(function(p) { return p.trim(); });
                return parts.length > 1 ? parts[1] : '';
            }
            */

            // ---- Build / reload the DataTable ----
            function loadTable(params) {
                var url = '/Sms/GetTechnicianJobsData'
                    + '?status='     + encodeURIComponent(params.status     || '')
                    + '&dateFrom='   + encodeURIComponent(params.dateFrom   || '')
                    + '&dateTo='     + encodeURIComponent(params.dateTo     || '');

                if (table) {
                    table.destroy();
                    $('#tblTechJobs thead tr').html(
                        '<th>Technician</th><th>Time</th><th>Order #</th>' +
                        '<th>Customer</th><th>Street</th><th>City / State</th><th>ZIP</th>' +
                        '<th>Distance</th><th>Phone</th><th>Quoted</th><th>Status</th>');
                }

                table = $('#tblTechJobs').DataTable({
                    ajax: {
                        url: url,
                        type: 'GET',
                        dataSrc: function (json) {
                            if (json.error) { alert('Error: ' + json.error); return []; }
                            updateStats(json.aaData || []);
                            populateTechnicianFilter(json.aaData || []);
                            return json.aaData || [];
                        }
                    },
                    processing: true,
                    paging: true,
                    pageLength: 25,
                    language: {
                        emptyTable: 'No jobs found.',
                        processing: '<div class="text-center py-3"><i class="fa fa-spinner fa-spin fa-2x" style="color:#70b3db;"></i></div>'
                    },
                    // Sort by technician name first, then job start time
                    order: [[0, 'asc'], [1, 'asc']],
                    columns: [
                        // 0: Technician
                        {
                            data: 'technicianName',
                            render: function (d) {
                                return '<span style="font-weight:600;">' + esc(d) + '</span>';
                            }
                        },
                        // 1: Time (startTime in HH:MM AM/PM format - hh:mm tt from controller)
                        {
                            data: 'startTime',
                            render: function (d, type, row) {
                                if (type === 'sort') {
                                    /* Sort by 24-hour time from startAt field (MM/dd/yyyy hh:mm tt) */
                                    if (row.startAt) {
                                        var parts = row.startAt.split(' ');
                                        var time = parts[1]; // hh:mm
                                        var ampm = parts[2]; // AM/PM
                                        var hours = parseInt(time.split(':')[0], 10);
                                        if (ampm === 'PM' && hours !== 12) hours += 12;
                                        if (ampm === 'AM' && hours === 12) hours = 0;
                                        return ('0' + hours).slice(-2) + time.split(':')[1];
                                    }
                                    return d;
                                }
                                return '<span style="white-space:nowrap;">' + esc(d) + '</span>';
                            }
                        },
                        // 2: Order # (monospace badge)
                        {
                            data: 'jobId', width: '80px',
                            render: function (d) {
                                return '<span class="tj-order-badge">#' + d + '</span>';
                            }
                        },
                        // 3: Customer Name
                        { data: 'customerName', render: function (d) { return esc(d); } },
                        // 4: Street Address
                        { data: 'streetAddress', render: function (d) { return esc(d || '—'); } },
                        // 5: City / State (combined, exactly as stored)
                        {
                            data: 'cityState',
                            render: function (d) { return esc(d || '—'); }
                        },
                        // 6: ZIP Code (was column 7, now 6)
                        { data: 'zipCode', render: function (d) { return esc(d || '—'); } },
                        // 7: Distance (was column 8, now 7)
                        {
                            data: 'distanceMiles',
                            render: function (d, type, row) {
                                if (type === 'sort') return row.distanceRaw != null ? row.distanceRaw : 99999;
                                if (!d || d === 'N/A') return '<span class="tj-dist-badge"><i class="fa fa-map-marker-alt me-1"></i>N/A</span>';
                                return '<span class="tj-dist-badge"><i class="fa fa-map-marker-alt me-1"></i>' + esc(d) + '</span>';
                            }
                        },
                        // 8: Phone # (tel: link) (was column 9, now 8)
                        {
                            data: 'phoneNumber',
                            render: function (d) {
                                if (!d || d === 'N/A') return 'N/A';
                                return '<a href="tel:' + esc(d) + '" style="white-space:nowrap; font-weight:600; color:#4338ca;">' + esc(d) + '</a>';
                            }
                        },
                        // 9: Quoted Amount (right-aligned currency) (was column 10, now 9)
                        {
                            data: 'quotedAmount',
                            render: function (d, type) {
                                if (type === 'sort') return (d !== '' && d != null) ? parseFloat(d) : -1;
                                if (d === '' || d == null)
                                    return '<span class="tj-amount-empty">—</span>';
                                return '<span class="tj-amount">$' + esc(d) + '</span>';
                            }
                        },
                        // 10: Status (was column 11, now 10)
                        {
                            data: 'effectiveStatus',
                            render: function (d) {
                                var icons = { 'Scheduled': 'fa-calendar', 'Confirmed': 'fa-check-circle', 'Completed': 'fa-flag-checkered', 'Cancelled': 'fa-ban' };
                                var cls  = 'tj-status tj-status-' + (d || '').toLowerCase();
                                var icon = icons[d] || 'fa-circle';
                                return '<span class="' + cls + '"><i class="fa ' + icon + ' me-1"></i>' + esc(d) + '</span>';
                            }
                        }
                    ],
                    /* Column alignment and sizing via columnDefs (applied to both th and td) */
                    /* ROUND 5: Added min-width per column to prevent overlap. Total table min-width ≈ 1450px */
                    columnDefs: [
                        /* 0: Technician 190px (sticky left) */
                        { targets: [0], className: 'dt-left', render: function(d, type, row) { if(type === 'display') return '<span class="tj-tech-col">' + (typeof d === 'function' ? d : d) + '</span>'; return d; }, width: '190px' },
                        /* 1: Time 100px, left-aligned */
                        { targets: [1], className: 'dt-left', width: '100px' },
                        /* 2: Order# 85px, left-aligned */
                        { targets: [2], className: 'dt-left', width: '85px' },
                        /* 3: Customer 150px, left-aligned */
                        { targets: [3], className: 'dt-left', width: '150px' },
                        /* 4: Street 200px, left-aligned */
                        { targets: [4], className: 'dt-left', width: '200px' },
                        /* 5: City/State 150px, left-aligned */
                        { targets: [5], className: 'dt-left', width: '150px' },
                        /* 6: ZIP 80px, center-aligned */
                        { targets: [6], className: 'dt-center', width: '80px' },
                        /* 7: Distance 120px, center-aligned */
                        { targets: [7], className: 'dt-center', width: '120px' },
                        /* 8: Phone 150px, left-aligned */
                        { targets: [8], className: 'dt-left', width: '150px' },
                        /* 9: Quoted 100px, right-aligned */
                        { targets: [9], className: 'dt-right', width: '100px' },
                        /* 10: Status 130px, center-aligned */
                        { targets: [10], className: 'dt-center', width: '130px' }
                    ],
                    rowCallback: function (row, data) {
                        // Add data attributes for client-side filtering
                        $(row).attr('data-status', data.effectiveStatus);
                        $(row).attr('data-tech', data.technicianName);
                        $(row).attr('data-date', data.startDate);
                    },
                    drawCallback: function () {
                        // Insert technician group-header rows between technician blocks
                        var api = this.api();  /* CORRECT: Use this.api() inside DataTables callbacks */
                        var lastTech = null;
                        var techCounts = {};
                        var techQuoted = {};
                        
                        // Count jobs and total quoted per technician
                        api.rows({ page: 'current' }).data().each(function (row) {
                            if (!techCounts[row.technicianName]) {
                                techCounts[row.technicianName] = 0;
                                techQuoted[row.technicianName] = 0;
                            }
                            techCounts[row.technicianName]++;
                            if (row.quotedAmount && row.quotedAmount !== '') {
                                techQuoted[row.technicianName] += parseFloat(row.quotedAmount);
                            }
                        });

                        var domRows = api.rows({ page: 'current' }).nodes();
                        api.rows({ page: 'current' }).data().each(function (row, i) {
                            var tech = row.technicianName;
                            if (tech !== lastTech) {
                                var icon = (tech === 'Unassigned')
                                    ? '<i class="fa fa-question-circle me-2 text-muted"></i>'
                                    : '<i class="fa fa-hard-hat me-2" style="color:#2563eb;"></i>';
                                var jobCount = techCounts[tech];
                                var totalQuoted = techQuoted[tech] > 0 ? '$' + techQuoted[tech].toFixed(2) : '—';
                                /* ROUND 5: Added sticky positioning to group band header */
                                $('<tr class="tj-tech-group-row"><td colspan="11" style="position:sticky; left:0; font-weight:700; color:#1e3a8a; font-size:0.95rem; background:#f8fafc;">'
                                    + icon + esc(tech) + ' <span style="font-weight:500; color:#666;">(' + jobCount + ' job' + (jobCount !== 1 ? 's' : '') + ', Total: ' + totalQuoted + ')</span></td></tr>')
                                    .insertBefore(domRows[i]);
                                lastTech = tech;
                            }
                        });
                    }
                });

                // Add custom search function for client-side filtering
                $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                    if (settings.nTable.id !== 'tblTechJobs') return true;

                    var $row = $(settings.aoData[dataIndex].nTr);
                    var rowStatus = $row.attr('data-status') || '';
                    var rowTech = $row.attr('data-tech') || '';
                    var rowDate = $row.attr('data-date') || '';

                    var statusVal = $('#filterStatus').val();
                    var techVal = $('#filterTechnician').val();
                    var dateFromVal = $('#filterDateFrom').val();
                    var dateToVal = $('#filterDateTo').val();

                    // Status filter
                    if (statusVal && rowStatus !== statusVal) return false;

                    // Technician filter
                    if (techVal && rowTech !== techVal) return false;

                    // Date From filter
                    if (dateFromVal) {
                        var cellDate = rowDate ? rowDate.split('/').reverse().join('-') : '';
                        if (cellDate < dateFromVal) return false;
                    }

                    // Date To filter
                    if (dateToVal) {
                        var cellDate = rowDate ? rowDate.split('/').reverse().join('-') : '';
                        if (cellDate > dateToVal) return false;
                    }

                    return true;
                });
            }

            // ---- Stats ----
            function updateStats(data) {
                $('#statTotal').text(data.length);
                $('#statScheduled').text(data.filter(function (r) {
                    return r.effectiveStatus === 'Scheduled' || r.effectiveStatus === 'Confirmed';
                }).length);
                $('#statCompleted').text(data.filter(function (r) { return r.effectiveStatus === 'Completed'; }).length);
                $('#statCancelled').text(data.filter(function (r) { return r.effectiveStatus === 'Cancelled'; }).length);
            }

            // ---- Populate Technician Filter ----
            function populateTechnicianFilter(data) {
                var techs = {};
                data.forEach(function (row) {
                    techs[row.technicianName] = true;
                });
                var techList = Object.keys(techs).sort();
                
                var currentVal = $('#filterTechnician').val();
                $('#filterTechnician').html('<option value="">All Technicians</option>');
                techList.forEach(function (tech) {
                    $('#filterTechnician').append('<option value="' + esc(tech) + '">' + esc(tech) + '</option>');
                });
                
                if (currentVal && techList.indexOf(currentVal) >= 0) {
                    $('#filterTechnician').val(currentVal);
                }
            }

            // ---- Filters: Instant filtering on change/input ----
            function applyFilter() {
                currentParams = {
                    status:     $('#filterStatus').val(),
                    technician: $('#filterTechnician').val(),
                    dateFrom:   $('#filterDateFrom').val(),
                    dateTo:     $('#filterDateTo').val()
                };
                table.draw();
                updateLiveStats();
            }

            // Instant filter on any input change (Status, Technician, Date From, Date To)
            $('#filterStatus, #filterTechnician, #filterDateFrom, #filterDateTo').on('change input', function () {
                applyFilter();
            });

            // Apply button: manual re-run (for explicit apply if needed)
            $('#btnApplyFilter').on('click', function () {
                applyFilter();
            });

            // Clear button: reset all filters
            $('#btnClearFilter').on('click', function () {
                $('#filterStatus').val('');
                $('#filterTechnician').val('');
                $('#filterDateFrom').val('');
                $('#filterDateTo').val('');
                $('#tblTechJobs_filter input').val('');
                currentParams = { status: '', technician: '', dateFrom: '', dateTo: '' };
                table.draw();
                updateLiveStats();
            });

            // ---- Live stats update after filtering ----
            function updateLiveStats() {
                /* OLD: var api = table.api(); */
                var visibleData = table.rows({ search: 'applied' }).data().toArray();  /* Use table directly */
                $('#statTotal').text(visibleData.length);
                $('#statScheduled').text(visibleData.filter(function (r) {
                    return r.effectiveStatus === 'Scheduled' || r.effectiveStatus === 'Confirmed';
                }).length);
                $('#statCompleted').text(visibleData.filter(function (r) { return r.effectiveStatus === 'Completed'; }).length);
                $('#statCancelled').text(visibleData.filter(function (r) { return r.effectiveStatus === 'Cancelled'; }).length);
            }

            // ---- CSV Export (respects current search/filter) ----
            $('#btnExportCsv').on('click', function () {
                if (!table) return;
                var rows = table.rows({ search: 'applied' }).data().toArray();
                var headers = ['Technician', 'Time', 'Order #', 'Customer', 'Street', 'City / State', 'ZIP', 'Distance', 'Phone', 'Quoted', 'Status'];
                var lines = [headers.join(',')];
                rows.forEach(function (r) {
                    lines.push([
                        csvEsc(r.technicianName),
                        csvEsc(r.startTime),
                        r.jobId,
                        csvEsc(r.customerName),
                        csvEsc(r.streetAddress),
                        csvEsc(r.cityState),  /* Combined City / State, not parsed */
                        csvEsc(r.zipCode),
                        csvEsc(r.distanceMiles),
                        csvEsc(r.phoneNumber),
                        r.quotedAmount !== '' && r.quotedAmount != null ? '$' + r.quotedAmount : '',
                        csvEsc(r.effectiveStatus)
                    ].join(','));
                });
                var blob = new Blob([lines.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
                var link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = 'TechnicianJobs_' + new Date().toISOString().slice(0, 10) + '.csv';
                link.click();
            });

            // ---- Initial load ----
            loadTable(currentParams);

        })();
    </script>
}
