@{
    ViewData["Title"] = "OpenAttachments";
}

@model List<MmsLinks>

<section class="nova-page-head" aria-label="Page heading">
    <div class="nova-heading-group">
        <span class="nova-heading-icon" aria-hidden="true"><i class="fa fa-paperclip"></i></span>
        <div class="nova-heading-copy"><span class="nova-eyebrow">MEDIA LIBRARY</span><h1>Message attachments</h1><p>Review and download media shared in this conversation</p></div>
    </div>
</section>
<div class="sg-attachment-page">
    <div class="jumbotron">
        <h2>@ViewBag.SmsBody</h2>
    </div>

    <section class="nova-list-card" aria-label="Attachments">
        <div class="nova-list-toolbar"><div class="nova-list-heading"><span class="nova-list-heading-icon"><i class="fa fa-paperclip" aria-hidden="true"></i></span><div><h2>Attached files</h2><p>Media and download options</p></div></div></div>
        <div class="nova-table-viewport">
    <table class="table table-bordered sg-attachment-table">
        <thead>
            <tr>
                <th>File</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var attachment in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(attachment.FileName))
                        {
                            <div class="attachment-name" style="font-size:.85rem;color:#555;margin-bottom:.2rem;word-break:break-all;">@attachment.FileName</div>
                        }
                        else if (!string.IsNullOrWhiteSpace(attachment.Location))
                        {
                            <div class="attachment-name" style="font-size:.85rem;color:#555;margin-bottom:.2rem;word-break:break-all;">@attachment.Location.Split('/').LastOrDefault() ?? "Attachment"</div>
                        }
                        @if (IsImage(attachment.FileName))
                        {
                            <img src="@AttachmentUrl(attachment)" alt="Image preview" style="max-width: 300px; max-height: 300px;" />
                        }
                        else if (IsAudio(attachment.FileName))
                        {
                            <audio controls>
                                <source src="@AttachmentUrl(attachment)" type="audio/mpeg">
                                Your browser does not support the audio tag.
                            </audio>
                        }
                        else if (IsVideo(attachment.FileName))
                        {
                            <video width="320" height="240" controls>
                                <source src="@AttachmentUrl(attachment)" type="video/mp4">
                                Your browser does not support the video tag.
                            </video>
                        }
                        else
                        {
                            @attachment.FileName
                        }
                    </td>
                    <td>
                        @if (IsImage(attachment.FileName))
                        {
                            <button class="btn btn-outline-primary btn-sm" type="button" data-view-image="@AttachmentUrl(attachment)" data-image-name="@attachment.FileName">
                                <i class="fa fa-eye" aria-hidden="true"></i> View image
                            </button>
                        }
                        <button class="btn btn-primary btn-sm" type="button" onclick="downloadAttachment('@DownloadUrl(attachment)')"><i class="fa fa-download" aria-hidden="true"></i> Download</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
        </div>
    </section>

</div>

<dialog id="imageViewer" aria-label="Image viewer" style="border: 0; border-radius: 12px; max-width: 95vw; max-height: 95vh; padding: 1rem;">
    <div style="display: flex; justify-content: flex-end; margin-bottom: .5rem;">
        <button class="btn btn-outline-secondary btn-sm" type="button" id="closeImageViewer">Close</button>
    </div>
    <img id="imageViewerContent" alt="Attachment image" style="display: block; max-width: 88vw; max-height: 82vh; object-fit: contain;" />
</dialog>

<script>
@functions {
        string AttachmentUrl(MmsLinks attachment)
        {
                var source = AttachmentUrlResolver.ResolveSource(attachment.Location, attachment.FileName);
                if (source == AttachmentUrlSource.Remote)
                {
                        return attachment.Location!;
                }
                if (source == AttachmentUrlSource.None)
                {
                        return string.Empty;
                }

                // Local: derive a local path and serve it only when the file actually exists.
                var path = (attachment.FileName ?? string.Empty).Replace('\\', '/').TrimStart('/');
                var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
                if (segments.Length == 0 || segments.Any(segment => segment == "." || segment == ".."))
                {
                        return string.Empty;
                }

                if (!string.Equals(segments[0], "uploads", StringComparison.OrdinalIgnoreCase)
                    && !string.Equals(segments[0], "downloads", StringComparison.OrdinalIgnoreCase))
                {
                        path = "uploads/" + path;
                }

                var env = Context.RequestServices.GetRequiredService<Microsoft.AspNetCore.Hosting.IWebHostEnvironment>();
                var localFilePath = System.IO.Path.Combine(env.WebRootPath, path.Replace('/', System.IO.Path.DirectorySeparatorChar));
                if (!System.IO.File.Exists(localFilePath))
                {
                        return string.Empty;
                }

                var encodedPath = string.Join("/", path.Split('/').Select(Uri.EscapeDataString));
                return Url.Content("~/" + encodedPath);
        }

        string DownloadUrl(MmsLinks attachment)
        {
                if (AttachmentUrlResolver.ResolveSource(attachment.Location, attachment.FileName) == AttachmentUrlSource.Remote)
                {
                        return attachment.Location!;
                }
                return attachment.FileName ?? string.Empty;
        }

        bool IsImage(string? fileName)
        {
                string[] imageExtensions = { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".tiff", ".webp" };
                return fileName != null && imageExtensions.Any(ext => fileName.EndsWith(ext, StringComparison.OrdinalIgnoreCase));
        }

        bool IsAudio(string? fileName)
        {
                string[] audioExtensions = { ".mp3", ".wav", ".ogg", ".flac", ".aac" };
                return fileName != null && audioExtensions.Any(ext => fileName.EndsWith(ext, StringComparison.OrdinalIgnoreCase));
        }

        bool IsVideo(string? fileName)
        {
                string[] videoExtensions = { ".mp4", ".avi", ".mkv", ".mov", ".wmv", ".flv" };
                return fileName != null && videoExtensions.Any(ext => fileName.EndsWith(ext, StringComparison.OrdinalIgnoreCase));
        }
}


const imageViewer = document.getElementById("imageViewer");
const imageViewerContent = document.getElementById("imageViewerContent");

document.addEventListener("click", function (event) {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest("[data-view-image]");
    if (!button) return;

    imageViewerContent.src = button.dataset.viewImage;
    imageViewerContent.alt = button.dataset.imageName || "Attachment image";
    imageViewer.showModal();
});

document.getElementById("closeImageViewer").addEventListener("click", function () {
    imageViewer.close();
});

function downloadAttachment(fileName) {
    window.location.href = '@Url.Action("DownloadMMSFileDirect", "Sms")' + '?fileName=' + encodeURIComponent(fileName);
}
</script>
