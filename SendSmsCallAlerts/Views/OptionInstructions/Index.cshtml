@model List<SendSmsCallAlerts.Models.OptInstVM>

@{
    ViewData["Title"] = "Option instructions";
}

<div class="d-flex justify-content-between align-items-center mb-2 signal-heading-row">
    <h1>Option's Instruction</h1>
    <div class="sg-page-actions">
        <a asp-action="Create" class="sg-create-button signal-create-link">Create New</a>
        <a asp-action="IncomingLogs" asp-controller="Sms" class="btn btn-secondary btn-sm">
        <i class="fa fa-arrow-left me-1"></i> Back to SMS Logs
    </a>
    </div>
</div>


<div class="signal-list-card">
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayName("Option")
            </th>
            <th>
                @Html.DisplayName("Instruction Order")
            </th>
            <th>
                @Html.DisplayName("Instruction")
            </th>
            <th>
                @Html.DisplayName("Twilio#")
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.OptionNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.InstructionOrder)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Instruction)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TwilioNumber)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="sg-table-link sg-table-link-edit">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="sg-table-link sg-table-link-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
