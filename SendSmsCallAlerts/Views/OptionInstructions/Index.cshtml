@model List<SendSmsCallAlerts.Models.OptInstVM>

@{
    ViewData["Title"] = "Option instructions";
}

<section class="nova-page-head" aria-label="Page heading">
    <div class="nova-heading-group">
        <span class="nova-heading-icon" aria-hidden="true"><i class="fa fa-list-alt"></i></span>
        <div class="nova-heading-copy">
            <span class="nova-eyebrow">INSTRUCTION LIBRARY</span>
            <h1>Option instructions</h1>
            <p>Review and organize call flow instructions</p>
        </div>
    </div>
    <div class="nova-page-actions">
        <a asp-action="IncomingLogs" asp-controller="Sms" class="btn btn-outline-secondary btn-sm sg-secondary-action">
        <i class="fa fa-arrow-left me-1"></i> Back to SMS Logs
    </a>
        <a asp-action="Create" class="sg-create-button signal-create-link sg-primary-action">Create New</a>
    </div>
</section>


<section class="nova-list-card" aria-label="All Option instructions">
    <div class="nova-list-toolbar">
        <div class="nova-list-heading"><span class="nova-list-heading-icon" aria-hidden="true"><i class="fa fa-list-ul"></i></span><div><h2>All Option instructions</h2><p>Review and organize call flow instructions</p></div></div>
        <div class="nova-list-controls"><label class="nova-search" for="search-novaOptionInstructionsTable"><i class="fa fa-search" aria-hidden="true"></i><span class="sr-only">Search All Option instructions</span><input type="search" id="search-novaOptionInstructionsTable" data-nova-search="novaOptionInstructionsTable" placeholder="Search records..." autocomplete="off" /></label></div>
    </div>
    <div class="nova-table-viewport">
<table id="novaOptionInstructionsTable" class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayName("Option")
            </th>
            <th>
                @Html.DisplayName("Instruction Order")
            </th>
            <th>
                @Html.DisplayName("Instruction")
            </th>
            <th>
                @Html.DisplayName("Twilio#")
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.OptionNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.InstructionOrder)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Instruction)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TwilioNumber)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="sg-table-link sg-table-link-edit">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="sg-table-link sg-table-link-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
</section>
