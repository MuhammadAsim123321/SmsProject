@model SendSmsCallAlerts.Controllers.RcCallsVm

@{
    ViewData["Title"] = "Outgoing Calls";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.1/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.datatables.net/1.12.1/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<style>
    .page-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        padding: 28px;
        margin: 20px;
    }

    .page-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 4px;
    }

    .page-subtitle {
        color: #888;
        font-size: 0.9rem;
        margin-bottom: 20px;
    }

    /* Main Heading */
    .nova-jobs-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 25px;
    }

    .nova-eyebrow {
        color: #70a9cc;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        margin-bottom: 5px;
    }

    /* List Cards */
    .nova-list-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        overflow: hidden;
    }

    .nova-list-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        padding: 18px 20px;
        border-bottom: 1px solid #edf0f5;
    }

    .nova-list-heading {
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .nova-list-heading h2 {
            font-size: 1.05rem;
            font-weight: 700;
            color: #2c3e50;
            margin: 0;
        }

        .nova-list-heading p {
            font-size: 0.82rem;
            color: #888;
            margin: 3px 0 0;
        }

    .nova-list-heading-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #edf6fc;
        color: #3895c7;
        font-size: 17px;
    }

    /* Date Filter */
    .rc-filter-form input[type="date"] {
        width: 160px;
        min-height: 38px;
        border-radius: 8px;
        border: 1px solid #ced4da;
        padding: 5px 9px;
    }

    .rc-filter-form .btn {
        border-radius: 8px;
    }

    /* Table */
    @* replaced by calls-shared-fix 2026-11-19: Table styling moved to calls-shared.css *@
    @*
    #tblOutgoingCalls {
        width: 100% !important;
        border-collapse: collapse;
    }

        #tblOutgoingCalls thead th {
            background-color: #70b3db;
            color: white;
            text-align: center;
            padding: 12px 10px;
            white-space: nowrap;
            border: none;
        }

        #tblOutgoingCalls tbody td {
            padding: 10px 12px;
            vertical-align: middle;
            border-bottom: 1px solid #f0f0f0;
            border-left: none;
            border-right: none;
            white-space: nowrap;
        }

        #tblOutgoingCalls tbody tr:hover {
            background-color: #f7fbff;
        }

        #tblOutgoingCalls tbody tr:nth-child(even) {
            background-color: #fafafa;
        }
    *@

    .nova-table-viewport {
        width: 100%;
        overflow-x: auto;
        padding: 0 15px 15px;
    }

    /* replaced by calls-align-techjobs 2026-11-19: Removed custom DataTables control styling to match Technician Jobs (Bootstrap5 defaults) */
    /* 
    .dataTables_wrapper .dataTables_filter input { ... }
    #tblOutgoingCalls_wrapper .dataTables_filter { ... }
    .dataTables_wrapper .dataTables_length select { ... }
    div.dataTables_wrapper div.dataTables_paginate ul.pagination { ... }
    */

    /* Mobile */
    @@media (max-width: 768px) {
        .page-card {
            padding: 16px;
            margin: 10px;
        }

        .nova-jobs-heading {
            align-items: flex-start;
        }

            .nova-jobs-heading > a {
                white-space: nowrap;
            }

        .rc-filter-form input[type="date"] {
            width: 100%;
        }

        .rc-filter-form > * {
            max-width: 100%;
        }

        /* replaced by calls-align-techjobs 2026-11-19: Removed custom DataTables filter styling from mobile breakpoint */
        /* 
        #tblOutgoingCalls_wrapper .dataTables_filter {
            text-align: left;
            margin-top: 12px;
        }
        #tblOutgoingCalls_wrapper .dataTables_filter input {
            width: 100%;
        }
        */
    }
</style>

<div class="page-card sg-jobs-card nova-jobs-page">

    <!-- Main Page Heading: Same as Scheduled Jobs -->
    <div class="nova-jobs-heading">

        <div>
            <div class="nova-eyebrow">CALLS OVERVIEW</div>

            <h1 class="page-title">
                <i class="fa fa-phone me-2" aria-hidden="true"></i>Outgoing Calls
            </h1>

            <div class="page-subtitle">
                Outbound calls placed through RingCentral
            </div>
        </div>

        <a asp-action="IncomingLogs"
           asp-controller="Sms"
           class="btn btn-secondary btn-sm">
            <i class="fa fa-arrow-left me-1"></i>
            Back to SMS Logs
        </a>

    </div>

    @if (Model.Error != null)
    {
        <div class="alert alert-danger">
            <i class="fa fa-exclamation-circle me-1"></i>
            <strong>Could not load calls.</strong> @Model.Error
        </div>
    }
    else
    {
        <!-- Filter Call History -->
        <div class="nova-list-card mb-3">

            <div class="nova-list-toolbar">

                <div class="nova-list-heading">

                    <span class="nova-list-heading-icon">
                        <i class="fa fa-calendar-alt"></i>
                    </span>

                    <div>
                        <h2>Filter call history</h2>
                        <p>Select a date range to view outgoing calls</p>
                    </div>

                </div>

            </div>

            <form method="get"
                  class="p-3 d-flex flex-wrap align-items-center gap-2 rc-filter-form"
                  id="rcFilters">

                <input type="date"
                       name="dateFrom"
                       class="form-control"
                       value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />

                <span>to</span>

                <input type="date"
                       name="dateTo"
                       class="form-control"
                       value="@Model.DateTo?.ToString("yyyy-MM-dd")" />

                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-filter me-1"></i>
                    Filter
                </button>

                <a href="@Url.Action("Index", "RingCentralCalls")"
                   class="btn btn-outline-secondary">
                    <i class="fa fa-times me-1"></i>
                    Clear
                </a>

                <span class="text-muted small ms-2">
                    <i class="fa fa-calendar-check me-1"></i>
                    Showing
                    @Model.DateFrom?.ToString("dd-MMM-yyyy")
                    &ndash;
                    @Model.DateTo?.ToString("dd-MMM-yyyy")
                </span>

            </form>

        </div>

        <!-- Outgoing Call Activity -->
        <div class="nova-list-card nova-jobs-table sg-fix-jobs calls-scope">

            <div class="nova-list-toolbar">

                <div class="nova-list-heading">

                    <span class="nova-list-heading-icon">
                        <i class="fa fa-phone-volume"></i>
                    </span>

                    <div>
                        <h2>Outgoing call activity</h2>
                        <p>View outgoing calls and connection results</p>
                    </div>

                </div>

            </div>

            <div class="nova-table-viewport">
                @* replaced by calls-shared-fix 2026-11-19: Outgoing calls table replaced with shared partial *@
                @* 
                <table class="table" id="tblOutgoingCalls">

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Duration</th>
                            <th>Result</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>

                                <td>@row.Date</td>

                                <td>@row.Time</td>

                                <td>
                                    @row.FromNumber

                                    @if (!string.IsNullOrWhiteSpace(row.FromName))
                                    {
                                        <small class="d-block text-muted">
                                            @row.FromName
                                        </small>
                                    }
                                </td>

                                <td>
                                    @row.ToNumber

                                    @if (!string.IsNullOrWhiteSpace(row.ToName))
                                    {
                                        <small class="d-block text-muted">
                                            @row.ToName
                                        </small>
                                    }
                                </td>

                                <td>
                                    @if (row.DurationSeconds > 0)
                                    {
                                        <span title="@row.DurationSeconds seconds">
                                            @row.Duration
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0:00</span>
                                    }
                                </td>

                                <td>
                                    <span class="nova-status @row.ResultCss">
                                        @row.Result
                                    </span>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
                *@

                @await Html.PartialAsync("_CallsTable", Model.Rows)
            </div>
        </div>
    }

</div>

@section Scripts {

    <script src="https://cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.12.1/js/dataTables.bootstrap5.min.js"></script>

    <script>
        @* replaced by calls-shared-fix 2026-11-19: DataTable init moved to _CallsTable.cshtml partial *@
        @*
        $(document).ready(function () {

            if ($('#tblOutgoingCalls').length) {

                $('#tblOutgoingCalls').DataTable({

                    processing: true,

                    scrollX: true,

                    autoWidth: false,

                    pageLength: 10,

                    lengthMenu: [10, 25, 50, 100],

                    order: [],

                    language: {
                        emptyTable: "No outgoing calls found for the selected date range.",

                        zeroRecords: "No matching outgoing calls found.",

                        processing:
                            '<div class="text-center py-3">' +
                            '<i class="fa fa-spinner fa-spin fa-2x" style="color:#70b3db;"></i>' +
                            '</div>',

                        search: "",

                        searchPlaceholder: "Search outgoing calls...",

                        lengthMenu: "Show _MENU_ entries",

                        info: "Showing _START_ to _END_ of _TOTAL_ calls",

                        infoEmpty: "Showing 0 to 0 of 0 calls",

                        infoFiltered: "(filtered from _MAX_ total calls)",

                        paginate: {
                            previous: "Previous",
                            next: "Next"
                        }
                    },

                    initComplete: function () {
                        this.api().columns.adjust();
                    }

                });
            }

            // Adjust table when the sidebar is toggled
            $('#toggle_btn, #mobile_btn').on('click', function () {

                setTimeout(function () {

                    if ($.fn.DataTable.isDataTable('#tblOutgoingCalls')) {

                        $('#tblOutgoingCalls')
                            .DataTable()
                            .columns.adjust();

                    }

                }, 320);

            });

        });
        *@
    </script>
}
