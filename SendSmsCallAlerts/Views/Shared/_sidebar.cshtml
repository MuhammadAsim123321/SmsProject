@inject SendSmsCallAlerts.Data.ApplicationDbContext Db
@using Microsoft.EntityFrameworkCore
@{
    var session = Context?.Request?.HttpContext?.Session;
    var isAdmin = session.IsAdmin();
    var hasTwilio = isAdmin;
    if (!isAdmin && int.TryParse(session?.GetString("UserId"), out var sidebarUserId))
    {
        var sidebarPhone = Db.User.AsNoTracking().Where(user => user.Id == sidebarUserId).Select(user => user.Phone).FirstOrDefault();
        hasTwilio = !string.IsNullOrWhiteSpace(sidebarPhone);
    }
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<aside class="sidebar signal-sidebar" id="sidebar" aria-label="Primary navigation">
    <div class="sidebar-inner slimscroll signal-sidebar-scroll">
        <div id="sidebar-menu" class="sidebar-menu signal-sidebar-menu">
            <div class="signal-sidebar-intro"><span class="signal-sidebar-kicker">WORKSPACE</span><span class="signal-sidebar-description">Messaging &amp; automation</span></div>
            <ul>
                @if (isAdmin)
                {
                    <li class="menu-title">OVERVIEW</li>
                    <li><a class="@(controller == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index"><i class="fa fa-tachometer" aria-hidden="true"></i><span>Dashboard</span></a></li>
                    <li><a class="@(controller == "StaffActivity" ? "active" : "")" asp-controller="StaffActivity" asp-action="Index"><i class="fa fa-line-chart" aria-hidden="true"></i><span>Staff Activity</span></a></li>

                }
                <li class="menu-title">MESSAGING</li>
                @if (hasTwilio)
                {
                    <li><a class="@(controller == "Sms" && action == "IncomingLogs" ? "active" : "")" asp-controller="Sms" asp-action="IncomingLogs"><i class="fa fa-inbox" aria-hidden="true"></i><span>Incoming SMS</span></a></li>
                    <li>
                        <a class="@(controller == "TechnicianMessages" ? "active" : "")"
                           asp-controller="TechnicianMessages" asp-action="Index">
                            <i class="fa fa-wrench" aria-hidden="true"></i>
                            <span>Technician Messages</span>
                        </a>
                    </li>
                    <li><a class="@(controller == "Conversations" ? "active" : "")" asp-controller="Conversations" asp-action="SMS"><i class="fa fa-paper-plane-o" aria-hidden="true"></i><span>Send SMS</span></a></li>
                }
                <li><a class="@(controller == "Sms" && action == "ScheduledJobs" ? "active" : "")" asp-controller="Sms" asp-action="ScheduledJobs"><i class="fa fa-clock-o" aria-hidden="true"></i><span>Scheduled jobs</span></a></li>
                <li><a class="@(controller == "Sms" && action == "TechnicianJobs" ? "active" : "")" asp-controller="Sms" asp-action="TechnicianJobs"><i class="fa fa-hard-hat" aria-hidden="true"></i><span>Technician jobs</span></a></li>
                <li class="menu-title">CALLS</li>
                <li><a class="@(controller == "RingCentralCalls" ? "active" : "")" asp-controller="RingCentralCalls" asp-action="Index"><i class="fa fa-phone" aria-hidden="true"></i><span>Outgoing calls</span></a></li>
                <li class="menu-title">CALL FLOWS</li>
                <li><a class="@(controller == "IvrOptions" ? "active" : "")" asp-controller="IvrOptions" asp-action="Index"><i class="fa fa-sitemap" aria-hidden="true"></i><span>Main options</span></a></li>
                <li><a class="@(controller == "OptionInstructions" ? "active" : "")" asp-controller="OptionInstructions" asp-action="Index"><i class="fa fa-list-alt" aria-hidden="true"></i><span>Option instructions</span></a></li>
                @if (hasTwilio)
                {
                    <li><a class="@(controller == "IntroSms" ? "active" : "")" asp-controller="IntroSms" asp-action="Create"><i class="fa fa-comment-o" aria-hidden="true"></i><span>Intro SMS</span></a></li>
                }
                @if (!isAdmin && !hasTwilio)
                {
                    <li class="signal-sidebar-info"><i class="fa fa-info-circle" aria-hidden="true"></i><span>Ask an administrator to assign your Twilio# to unlock messaging pages.</span></li>
                }
                <li class="menu-title">OPERATIONS</li>
                <li><a class="@(controller == "Technicians" ? "active" : "")" asp-controller="Technicians" asp-action="Index"><i class="fa fa-wrench" aria-hidden="true"></i><span>Technicians</span></a></li>
                <li><a class="@(controller == "AutomatedNotifications" ? "active" : "")" asp-controller="AutomatedNotifications" asp-action="Index"><i class="fa fa-bell-o" aria-hidden="true"></i><span>Automated SMS</span></a></li>
                <li><a class="@(controller == "SmsLogs" ? "active" : "")" asp-controller="SmsLogs" asp-action="Index"><i class="fa fa-list-alt" aria-hidden="true"></i><span>SMS Logs</span></a></li>
                @if (isAdmin)
                {
                    <li class="menu-title">ADMINISTRATION</li>
                    <li><a class="@(controller == "Twilio" && action != "BuyNumber" ? "active" : "")" asp-controller="Twilio" asp-action="Index"><i class="fa fa-phone" aria-hidden="true"></i><span>Twilio number</span></a></li>
                    <li><a class="@(controller == "ForwardNum" ? "active" : "")" asp-controller="ForwardNum" asp-action="Index"><i class="fa fa-exchange" aria-hidden="true"></i><span>Forward numbers</span></a></li>
                    <li><a class="@(controller == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index"><i class="fa fa-users" aria-hidden="true"></i><span>Users</span></a></li>
                    <li><a class="@(controller == "Twilio" && action == "BuyNumber" ? "active" : "")" asp-controller="Twilio" asp-action="BuyNumber"><i class="fa fa-shopping-cart" aria-hidden="true"></i><span>Buy &amp; configure number</span></a></li>
                    <li><a class="@(controller == "Schedulers" ? "active" : "")" asp-controller="Schedulers" asp-action="Index"><i class="fa fa-calendar" aria-hidden="true"></i><span>Schedulers</span></a></li>
                }
            </ul>
            <div class="signal-sidebar-footer"><span class="signal-sidebar-footer-icon"><i class="fa fa-shield" aria-hidden="true"></i></span><span>Operations dashboard<small>Secure workspace</small></span></div>
        </div>
    </div>
</aside>
