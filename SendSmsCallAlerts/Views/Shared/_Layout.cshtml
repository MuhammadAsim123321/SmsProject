@{
    var session = Context?.Request?.HttpContext?.Session;
    var role = session?.CurrentRole() ?? AppRoles.Staff;
    var userName = Context?.Request?.HttpContext?.Session?.GetString("UserName") ?? "";
    var isLoggedIn = session.IsLoggedIn();
    var isAdmin = session.IsAdmin();
    var routeController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var routeAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var areaLabel = routeController switch
    {
        "Dashboard" => "Overview",
        "Sms" => "Messages",
        "Conversations" => "Messages",
        "IvrOptions" => "Voice routing",
        "OptionInstructions" => "Voice routing",
        "IntroSms" => "Voice routing",
        "Twilio" => "Telephony",
        "ForwardNum" => "Telephony",
        "Schedulers" => "Automation",
        "AutomatedNotifications" => "Automation",
        "SmsTemplates" => "Messaging tools",
        "Technicians" => "Team",
        "Users" => "Administration",
        "RingCentralCalls" => "Calls",
        "StaffActivity" => "Administration",
        "TechnicianMessages" => "Messages",
        "Profile" => "Account",
        _ => "Workspace"
    };
    var displayPage = routeController switch
    {
        "Sms" when routeAction == "IncomingLogs" => "Incoming SMS",
        "Sms" when routeAction == "TechnicianJobs" => "Technician jobs",
        "Sms" when routeAction == "ScheduledJobs" => "Scheduled jobs",
        "Sms" when routeAction == "OpenAttachments" => "Attachments",
        "Conversations" when routeAction == "SMS" => "Send SMS",
        "Conversations" when routeAction == "Chat" => "Conversation",
        "IvrOptions" => "IVR options",
        "OptionInstructions" => "Option instructions",
        "IntroSms" => "Intro SMS",
        "Twilio" when routeAction == "BuyNumber" => "Buy Twilio number",
        "Twilio" => "Twilio numbers",
        "ForwardNum" => "Forward numbers",
        "Schedulers" => "Schedulers",
        "AutomatedNotifications" => "Automated SMS",
        "TechnicianMessages" => "Technician Messages",
        "SmsTemplates" => "SMS templates",
        "Technicians" => "Technicians",
        "Users" => "Users",
        "RingCentralCalls" => "Outgoing calls",
        "StaffActivity" => "Staff activity",
        "Profile" => "My profile",
        _ => routeController
    };
    var pageSuffix = routeAction switch
    {
        "Create" => "Create",
        "Edit" => "Edit",
        "Details" => "Details",
        "Delete" => "Delete",
        _ => ""
    };
    var pageHeading = string.IsNullOrEmpty(pageSuffix) ? displayPage : $"{pageSuffix} {displayPage}";
    var shortUser = string.IsNullOrWhiteSpace(userName) ? role : userName;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101e35" />
    <title>@pageHeading · Carpet Repair & Cleaning</title>
    
    @* CSS Loading Order (CRITICAL): Signal UI must be render-blocking to prevent FOUC.
       1. Legacy Bootstrap 4 + template CSS first (for existing plugins, modals, DataTables)
       2. Signal UI (nova) system CSS next (layout-critical, applies before first paint)
       3. Page-specific styles in @RenderSectionAsync("Styles", required: false) (allows overrides)
       4. Never: inline <style> tags in page content (cause full reflow on render) *@
    
    @* Keep the existing Bootstrap 4 assets: older AJAX modals, dropdowns and plugins rely on them. *@
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/assets/css/style.css" />
    
    @* Signal UI design system: render-blocking in <head> so nova styling applies before first paint *@
    <link rel="stylesheet" href="~/css/signal-ui-next.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/signal-list-tables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/toast.css?v=8" />
    
    @* Page-specific styles: legacy views that inject <style> tags move content here via @section Styles *@
    @await RenderSectionAsync("Styles", required: false)
    
    @* Sidebar collapsed state: apply via class on <html> before paint to prevent layout shift on reload *@
    <script>
        (function () {
            var collapsed = sessionStorage.getItem('signal-sidebar-collapsed') === 'true';
            if (collapsed && typeof document !== 'undefined') {
                document.documentElement.classList.add('signal-sidebar-collapsed');
            }
        })();
    </script>
    
    @* Fade-in animation for smooth page transitions (respects prefers-reduced-motion) *@
    <style>
        @@media (prefers-reduced-motion: no-preference) {
            .signal-view-surface {
                animation: signal-fade-in 120ms ease-out;
            }
        }

        @@keyframes signal-fade-in {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        /* DataTables: hide until initialized to prevent layout thrashing */
        .signal-view-surface .dataTables_wrapper {
            visibility: hidden;
            opacity: 0;
            transition: opacity 80ms ease-in 150ms;
        }

        .signal-view-surface .dataTables_wrapper.initialized {
            visibility: visible;
            opacity: 1;
        }

        @@media (prefers-reduced-motion: reduce) {
            .signal-view-surface .dataTables_wrapper {
                transition: none;
            }

            .signal-view-surface .dataTables_wrapper.initialized {
                opacity: 1;
            }
        }
    </style>
</head>
<body class="signal-app @(isLoggedIn ? "signal-authenticated" : "signal-guest")">
    <div class="main-wrapper @(isLoggedIn ? "has-sidebar" : "guest-shell")">
        @if (isLoggedIn)
        {
            <header class="header signal-header" role="banner">
                <div class="header-left signal-brand">
                    <a asp-controller="Sms" asp-action="IncomingLogs" class="signal-brand-link" aria-label="Carpet Repair & Cleaning — Incoming SMS">
                        <span class="signal-brand-icon" aria-hidden="true"><i class="fa fa-commenting-o"></i></span>
                        <span class="signal-brand-text">Carpet Repair & Cleaning<span class="signal-brand-sub">MESSAGING PLATFORM</span></span>
                    </a>
                </div>
                @* These IDs are used by the existing assets/js/app.js sidebar handlers. *@
                <a id="toggle_btn" class="signal-nav-toggle" href="javascript:void(0);" aria-label="Collapse navigation" title="Collapse navigation"><i class="fa fa-bars" aria-hidden="true"></i></a>
                <a id="mobile_btn" class="mobile_btn signal-mobile-toggle" href="#sidebar" aria-label="Open navigation"><i class="fa fa-bars" aria-hidden="true"></i></a>
                <div class="signal-topbar-context">
                    <span class="signal-location-label">@areaLabel</span>
                    <span class="signal-location-slash" aria-hidden="true">/</span>
                    <span class="signal-location-page">@pageHeading</span>
                </div>
                <ul class="nav user-menu float-right signal-user-menu">
                    <li class="nav-item dropdown has-arrow">
                        <a href="#" class="dropdown-toggle nav-link user-link signal-account-toggle" data-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
                            <span class="signal-avatar" aria-hidden="true"><i class="fa fa-user-o"></i></span>
                            <span class="signal-account-details"><strong>@shortUser</strong><small>@AppRoles.DisplayName(role)</small></span>
                            <i class="fa fa-angle-down signal-account-chevron" aria-hidden="true"></i>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right signal-account-dropdown">
                            <div class="signal-dropdown-label">Signed in as <strong>@shortUser</strong> <span class="badge badge-light">@AppRoles.DisplayName(role)</span></div>
                            <a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="fa fa-user-o" aria-hidden="true"></i> My profile</a>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Logout"><i class="fa fa-sign-out" aria-hidden="true"></i> Log out</a>
                        </div>
                    </li>
                </ul>
            </header>
            @await Html.PartialAsync("_Sidebar")
            <div class="sidebar-overlay"></div>
        }
        <div class="page-wrapper signal-page-wrapper">
            <main class="content container-fluid signal-page-content" id="main-content">
                <div class="signal-view-surface" data-controller="@routeController" data-action="@routeAction">
                    @RenderBody()
                </div>
            </main>
            @if (isLoggedIn)
            {
                <footer class="signal-footer"><span>Carpet Repair & Cleaning</span><span>Messaging operations workspace</span></footer>
            }
        </div>
    </div>
    @* This is intentionally after RenderBody: legacy pages inject their own style tags ONLY via @section Styles in <head>.
       Theme CSS (signal-ui-next.css, signal-list-tables.css) are now in <head> for render-blocking. *@
    @* Preserve the existing jquery/bootstrap plugin order and AJAX session-expiry behavior. *@
    <script src="~/assets/js/jquery-3.2.1.min.js"></script>
    <script src="~/assets/js/popper.min.js"></script>
    <script src="~/assets/js/bootstrap.min.js"></script>
    <script src="~/assets/js/jquery.slimscroll.js"></script>
    <script src="~/assets/js/app.js"></script>
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
    <script>
        (function () {
            var storageKey = 'signal-sidebar-scroll-top';
            function sidebarScrollElement() {
                return document.querySelector('.signal-sidebar-scroll');
            }
            function restoreSidebarScroll() {
                var sidebar = sidebarScrollElement();
                if (!sidebar) return;
                var saved = window.sessionStorage.getItem(storageKey);
                if (saved !== null) {
                    var top = parseInt(saved, 10);
                    if (!isNaN(top)) {
                        sidebar.scrollTop = top;
                        @* Restore scroll synchronously before paint; no setTimeout (was: 100ms, caused visible jump) *@
                    }
                }
            }
            document.addEventListener('DOMContentLoaded', function () {
                var sidebar = sidebarScrollElement();
                if (!sidebar) return;
                restoreSidebarScroll();
                sidebar.addEventListener('scroll', function () {
                    window.sessionStorage.setItem(storageKey, String(sidebar.scrollTop));
                });
                document.querySelectorAll('#sidebar-menu a[href]').forEach(function (link) {
                    link.addEventListener('click', function () {
                        window.sessionStorage.setItem(storageKey, String(sidebar.scrollTop));
                    });
                });
            });
        })();
    </script>
    <script>
        $(document).ajaxError(function (e, xhr, opts) {
            if (xhr.status === 403 && typeof xhr.responseText === 'string' && xhr.responseText.indexOf('LogOut') !== -1) {
                var currentPageUrl = window.location.href;
                var redirectUrl = '@Url.Action("Logout", "Account")' + '?id=-2&returnUrl=' + encodeURIComponent(currentPageUrl);
                window.location.href = redirectUrl;
            }
        });
    </script>
    @* Progressive, client-side search only for server-rendered list tables.
       Does not bind to or interfere with DataTables-backed tables. *@
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('[data-nova-search]').forEach(function (field) {
                var table = document.getElementById(field.getAttribute('data-nova-search'));
                if (!table || !table.tBodies || !table.tBodies.length) return;
                var card = field.closest('.nova-list-card');
                var meta = document.createElement('div');
                meta.className = 'nova-list-footer';
                meta.setAttribute('aria-live', 'polite');
                if (card) card.appendChild(meta);
                function filterRows() {
                    var query = field.value.trim().toLocaleLowerCase();
                    var visible = 0;
                    Array.prototype.forEach.call(table.tBodies[0].rows, function (row) {
                        var matching = !query || row.textContent.toLocaleLowerCase().indexOf(query) !== -1;
                        row.hidden = !matching;
                        if (matching) visible++;
                    });
                    meta.textContent = visible + (visible === 1 ? ' record' : ' records') + (query ? ' matching your search' : '');
                }
                field.addEventListener('input', filterRows);
                filterRows();
            });
        });
    </script>
    @if (isLoggedIn && SendSmsCallAlerts.Services.ActivityTracker.IsStaff(role))
    {
        <script>
            (function () {
                var touched = false;
                ['click', 'keydown', 'touchstart', 'wheel'].forEach(function (e) {
                    document.addEventListener(e, function () { touched = true; }, { passive: true });
                });
                setInterval(function () {
                    if (!touched || document.hidden) return;
                    touched = false;
                    fetch('/Activity/Ping', { method: 'POST', credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } }).catch(function () { });
                }, 60000);
            })();
        </script>
    }
    <script>
            (function () {
                function markReady() {
                    document.querySelectorAll('.dataTables_wrapper').forEach(function (w) { w.classList.add('initialized'); });
                }
                if (window.jQuery) { jQuery(document).on('init.dt draw.dt', markReady); }
                window.addEventListener('load', markReady);
                setTimeout(markReady, 1500); // fallback so a table can never stay hidden
            })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    @await Html.PartialAsync("_Toast")
    <script src="~/js/toast.js?v=6"></script>

    <!-- Global action confirmation modal -->
    <div class="modal fade" id="actionConfirmModal" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 92%;">
            <div class="modal-content border-0 shadow-sm" style="max-width: 380px; width: 100%; margin: 0 auto;">
                <div class="modal-header border-0 pb-2">
                    <h6 class="modal-title" id="actionConfirmTitle" style="font-size: 0.95rem;"><i class="fa fa-question-circle text-warning me-2"></i>Confirm Action</h6>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body text-center py-2">
                    <p id="actionConfirmMessage" class="mb-3" style="font-size: 0.9rem;">Are you sure you want to proceed?</p>
                </div>
                <div class="modal-footer border-0 pt-0 d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-light btn-sm px-4" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger btn-sm px-4" onclick="executeAction()">Yes, Proceed</button>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
