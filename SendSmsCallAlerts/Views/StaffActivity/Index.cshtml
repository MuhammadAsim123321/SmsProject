        }
        *@

        /* replaced by calls-align-techjobs 2026-11-19: Removed custom DataTables wrapper and control styling to match Technician Jobs (Bootstrap5 defaults) */
        @* 
        .sa-card #tblPhoneCalls_wrapper {
            margin: 0;
        }
        
        .sa-card .dataTables_wrapper .dataTables_length select {
            border-radius: 4px;
            border: 1px solid #cbd5e1;
            padding: 2px 4px;
        }
        
        .sa-card .dataTables_wrapper .dataTables_filter input {
            border-radius: 4px;
            border: 1px solid #cbd5e1;
            padding: 4px 8px;
        }
        
        .sa-card div.dataTables_wrapper div.dataTables_paginate ul.pagination {
            margin-top: 10px;
        }
        
        .sa-card div.dataTables_wrapper div.dataTables_info {
            color: #888;
            font-size: 0.85rem;
            padding-top: 15px;
        }
        *@
    </style>

    <script>
        (function () {
            'use strict';

            var TAB_KEY = 'saTab-index';

            // -------------------------
            // Tabs
            // -------------------------
            var tabButtons = document.querySelectorAll('.sa-tabs button[data-tab]');
            var panes = document.querySelectorAll('.sa-pane');

            function showTab(name) {
                var targetPane = document.getElementById('pane-' + name);
                var targetButton = document.querySelector('.sa-tabs button[data-tab="' + name + '"]');

                // Ignore invalid or unavailable tab names.
                if (!targetPane || !targetButton) return;

                tabButtons.forEach(function (button) {
                    button.classList.toggle('active', button === targetButton);
                });

                panes.forEach(function (pane) {
                    pane.classList.toggle('active', pane === targetPane);
                });
            }

            tabButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    var selectedTab = button.getAttribute('data-tab');
                    showTab(selectedTab);

                    try {
                        sessionStorage.setItem(TAB_KEY, selectedTab);
                    } catch (e) {
                        // The page still works if session storage is unavailable.
                    }
                });
            });

            // Restore the previously selected tab, if it still exists.
            try {
                var savedTab = sessionStorage.getItem(TAB_KEY);
                if (savedTab) {
                    showTab(savedTab);
                }
            } catch (e) {
                // Use the default active tab.
            }

            // -------------------------
            // Date preset buttons
            // -------------------------
            var form = document.querySelector('.sa-filter');

            if (form) {
                var fromInput = form.querySelector('input[name="from"]');
                var toInput = form.querySelector('input[name="to"]');
                var groupSelect = form.querySelector('select[name="group"]');

                if (fromInput && toInput) {
                    var presetButtons = document.querySelectorAll('.sa-quick button[data-from][data-to]');

                    presetButtons.forEach(function (button) {
                        button.classList.toggle(
                            'active',
                            button.dataset.from === fromInput.value &&
                            button.dataset.to === toInput.value
                        );

                        button.addEventListener('click', function () {
                            fromInput.value = button.dataset.from;
                            toInput.value = button.dataset.to;

                            // This field is present on Detail only.
                            if (groupSelect && button.dataset.group) {
                                groupSelect.value = button.dataset.group;
                            }

                            form.submit();
                        });
                    });
                }
            }

            // -------------------------
            // Phone calls DataTable
            // -------------------------
            @* replaced by calls-shared-fix 2026-11-19: DataTable init moved to _CallsTable.cshtml partial *@
            @*
            var phoneCallsTable = document.getElementById('tblPhoneCalls');

            if (phoneCallsTable && $.fn.DataTable) {
                $(phoneCallsTable).DataTable({
                    processing: true,
                    scrollX: true,
                    autoWidth: false,
                    pageLength: 10,
                    lengthMenu: [10, 25, 50, 100],
                    order: [],
                    language: {
                        emptyTable: "No outgoing calls found for the selected date range.",
                        zeroRecords: "No matching outgoing calls found.",
                        processing:
                            '<div class="text-center py-3">' +
                            '<i class="fa fa-spinner fa-spin fa-2x" style="color:#70b3db;"></i>' +
                            '</div>',
                        search: "",
                        searchPlaceholder: "Search calls...",
                        lengthMenu: "Show _MENU_ entries",
                        info: "Showing _START_ to _END_ of _TOTAL_ calls",
                        infoEmpty: "Showing 0 to 0 of 0 calls",
                        infoFiltered: "(filtered from _MAX_ total calls)",
                        paginate: {
                            previous: "Previous",
                            next: "Next"
                        }
                    },
                    initComplete: function () {
                        this.api().columns.adjust();
                    }
                });
            }

            // Adjust phone calls table when sidebar is toggled
            $('#toggle_btn, #mobile_btn').on('click', function () {
                setTimeout(function () {
                    if ($.fn.DataTable.isDataTable('#tblPhoneCalls')) {
                        $('#tblPhoneCalls').DataTable().columns.adjust();
                    }
                }, 320);
            });
            *@
        })();
    </script>
}
