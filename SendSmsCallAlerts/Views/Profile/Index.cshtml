@model SendSmsCallAlerts.Models.ProfilePageViewModel

@{
    ViewData["Title"] = "My profile";
}

<section class="nova-page-head" aria-label="Page heading">
    <div class="nova-heading-group">
        <span class="nova-heading-icon" aria-hidden="true"><i class="fa fa-user-o"></i></span>
        <div class="nova-heading-copy"><span class="nova-eyebrow">ACCOUNT</span><h1>My profile</h1><p>Manage your contact details and password</p></div>
    </div>
</section>

<div class="row profile-cards">
        <section class="card"><div class="card-header">Profile details</div><div class="card-body">
            <form asp-action="UpdateProfile" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group"><label>Username</label><input class="form-control" value="@Model.Username" readonly /></div>
                <div class="form-group"><label>Role</label><div><span class="badge @(Model.Role == AppRoles.Admin ? "badge-primary" : "badge-info")">@AppRoles.DisplayName(Model.Role)</span></div></div>
                <div class="form-group"><label asp-for="Profile.Name"></label><input asp-for="Profile.Name" class="form-control" /><span asp-validation-for="Profile.Name" class="text-danger"></span></div>
                <div class="form-group"><label asp-for="Profile.Email"></label><input asp-for="Profile.Email" class="form-control" /><span asp-validation-for="Profile.Email" class="text-danger"></span></div>
                <div class="form-group"><label>Twilio#</label><input class="form-control" value="@Model.Phone" readonly /><small class="form-text text-muted">Set by an administrator</small></div>
                <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Save profile</button>
            </form>
        </div></section>
    </div>
    <div class="col-12 mb-4">
        <section class="card"><div class="card-header"><button type="button" class="btn btn-link p-0 profile-password-toggle" data-toggle="collapse" data-target="#profile-password-card" aria-expanded="@Model.PasswordOpen.ToString().ToLowerInvariant()" aria-controls="profile-password-card"><i class="fa fa-key"></i> Change password</button></div><div id="profile-password-card" class="card-body collapse @(Model.PasswordOpen ? "show" : "")">
            <form asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group"><label asp-for="Password.CurrentPassword"></label><input asp-for="Password.CurrentPassword" class="form-control" autocomplete="current-password" /><span asp-validation-for="Password.CurrentPassword" class="text-danger"></span></div>
                <div class="form-group"><label asp-for="Password.NewPassword"></label><input asp-for="Password.NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password.NewPassword" class="text-danger"></span></div>
                <div class="form-group"><label asp-for="Password.ConfirmPassword"></label><input asp-for="Password.ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password.ConfirmPassword" class="text-danger"></span></div>
                <div class="profile-password-actions"><button type="submit" class="btn btn-primary"><i class="fa fa-key"></i> Update password</button><button type="button" class="btn btn-outline-secondary" data-toggle="collapse" data-target="#profile-password-card" id="cancel-password-change">Cancel</button></div>
            </form>
        </div></section>
    </div>
</div>

@section Scripts {
    <script>
        $('#cancel-password-change').on('click', function () {
            var card = $('#profile-password-card');
            card.find('input[type="password"], input[type="text"]').val('').attr('type', 'password');
            card.find('.field-validation-error').empty().removeClass('field-validation-error').addClass('field-validation-valid');
            card.collapse('hide');
        });
    </script>
}