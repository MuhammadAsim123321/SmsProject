@model IEnumerable<SendSmsCallAlerts.Models.SmsTemplate>

@{
    ViewData["Title"] = "SMS templates";
}

<section class="nova-page-head" aria-label="Page heading">
    <div class="nova-heading-group">
        <span class="nova-heading-icon" aria-hidden="true"><i class="fa fa-file-text-o"></i></span>
        <div class="nova-heading-copy">
            <span class="nova-eyebrow">CONTENT LIBRARY</span>
            <h1>SMS templates</h1>
            <p>Reusable message content in one place</p>
        </div>
    </div>
    <div class="nova-page-actions"><a asp-action="Create" class="signal-create-link sg-primary-action"><i class="fa fa-plus" aria-hidden="true"></i> Create template</a></div>
</section>

@if (TempData["StMsg"] != null)
{
    <div class="alert alert-success">
        <b>@TempData["StMsg"]</b>
    </div>
}


<section class="nova-list-card" aria-label="All SMS templates">
    <div class="nova-list-toolbar">
        <div class="nova-list-heading"><span class="nova-list-heading-icon" aria-hidden="true"><i class="fa fa-list-ul"></i></span><div><h2>All SMS templates</h2><p>Reusable message content in one place</p></div></div>
        <div class="nova-list-controls"><label class="nova-search" for="search-novaSmsTemplatesTable"><i class="fa fa-search" aria-hidden="true"></i><span class="sr-only">Search All SMS templates</span><input type="search" id="search-novaSmsTemplatesTable" data-nova-search="novaSmsTemplatesTable" placeholder="Search records..." autocomplete="off" /></label></div>
    </div>
    <div class="nova-table-viewport">
<table id="novaSmsTemplatesTable" class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayName("Name")
            </th>
            <th>
                @Html.DisplayName("Template Body")
            </th>
            <th>
                @Html.DisplayName("Image")
            </th>
            @*   <th>
            @Html.DisplayNameFor(model => model.createdOn)
            </th>*@
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.templateBody)
                </td>
                <td>
                    @if (item.imgPath == "")
                    {
                        <span>N/A</span>
                    }
                    else
                    {
                        <img src="@item.imgPath" width='100' height='100' />
                    }

                </td>
                @*  <td>
            @Html.DisplayFor(modelItem => item.createdOn)
            </td>*@
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="sg-table-link sg-table-link-edit">Edit</a>
                    @* <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="sg-table-link sg-table-link-danger">Delete</a>*@
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
</section>
