@model SendSmsCallAlerts.Models.AutomatedSmsSetting
@{
    ViewData["Title"] = "Edit Automated SMS";
}

<partial name="_AutoSmsHead" />

<div class="sg-content-stack">
    <section class="nova-page-head" aria-label="Page heading">
        <div class="nova-heading-group">
            <span class="nova-heading-icon" aria-hidden="true"><i class="fa fa-pencil-square-o"></i></span>
            <div class="nova-heading-copy">
                <span class="nova-eyebrow">EDIT SETTING</span>
                <h1>@Model.Name</h1>
                <p>Update notification rules and content</p>
            </div>
        </div>
    </section>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <partial name="_Form" model="Model" />
        
        <div class="sg-form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="fa fa-save mr-1"></i> Save changes
            </button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
