@model SendSmsCallAlerts.Controllers.RunNowVm
@{
    ViewData["Title"] = "Test run";
}

<partial name="_AutoSmsHead" />

<div class="sg-content-stack sg-results-page">
    <h1>Test run: @Model.SettingName</h1>
    <p class="text-muted">Preview only: @Model.PreviewDescription. Nothing was sent. Recipients and message fields are built from the selected notification type and the matching database records.</p>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-warning">No matching recipients or records were found for this notification type and preview period.</div>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead style="background: #70b3db; color: white;">
                <tr><th>Recipient type</th><th>Recipient</th><th>Phone</th><th>Message preview</th><th>Result</th></tr>
            </thead>
            <tbody>
                @foreach (var i in Model.Items)
                {
                    <tr><td>@i.RecipientType</td><td>@i.RecipientName</td><td>@i.Phone</td><td style="white-space:pre-wrap">@i.Body</td><td>@i.Status</td></tr>
                }
            </tbody>
        </table>
    }
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>