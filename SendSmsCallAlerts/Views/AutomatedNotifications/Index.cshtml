@model IEnumerable<SendSmsCallAlerts.Models.AutomatedSmsSetting>
@using SendSmsCallAlerts.Controllers
@{
    ViewData["Title"] = "Automated SMS";
    var logs = (List<AutomatedLogRow>)ViewBag.RecentLogs;
    var days = new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
}

<partial name="_AutoSmsHead" />

<div class="sg-content-stack">
    <section class="nova-page-head" aria-label="Page heading">
    <div class="nova-heading-group">
        <span class="nova-heading-icon" aria-hidden="true"><i class="fa fa-bell-o"></i></span>
        <div class="nova-heading-copy">
            <span class="nova-eyebrow">SCHEDULE RULES</span>
            <h1>Automated SMS</h1>
            <p>Configure schedules and view delivery activity</p>
        </div>
    </div>
    <div class="nova-page-actions"><a asp-action="Create" class="btn btn-primary sg-primary-action">
            <i class="fa fa-plus me-1"></i> New setting
        </a></div>
</section>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success"><b>@TempData["Success"]</b></div>
    }

    <section class="nova-list-card sg-fix-automation" aria-label="Automated settings">
    <div class="nova-list-toolbar">
        <div class="nova-list-heading"><span class="nova-list-heading-icon" aria-hidden="true"><i class="fa fa-list-ul"></i></span><div><h2>Automated settings</h2><p>Scheduled messages and recipient rules</p></div></div>
        <div class="nova-list-controls"><label class="nova-search" for="search-novaAutomatedTable"><i class="fa fa-search" aria-hidden="true"></i><span class="sr-only">Search Automated settings</span><input type="search" id="search-novaAutomatedTable" data-nova-search="novaAutomatedTable" placeholder="Search records..." autocomplete="off" /></label></div>
    </div>
    <div class="nova-table-viewport">
<table id="novaAutomatedTable" class="table table-bordered table-striped">
            <thead style="background: #70b3db; color: white;">
                <tr>
                    <th>Name</th>
                    <th>Recipients</th>
                    <th>Schedule</th>
                    <th>Message</th>
                    <th>Active</th>
                    <th style="width:330px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    var time = DateTime.Today.Add(s.SendTime).ToString("hh:mm tt");
                    var schedule = s.Frequency == "Weekly"
                        ? $"Every {days[s.DayOfWeek ?? 0]} at {time}"
                        : $"Every day at {time}";
                    <tr>
                        <td>@s.Name</td>
                        <td>@s.RecipientType</td>
                        <td>@schedule</td>
                        <td style="white-space:pre-wrap">@s.TemplateBody</td>
                        <td><span class="nova-status @(s.IsActive ? "nova-status--active" : "nova-status--muted")">@(s.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="sg-automated-actions">
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-primary">Edit</a>
                            <form asp-action="ToggleActive" asp-route-id="@s.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-warning">@(s.IsActive ? "Deactivate" : "Activate")</button>
                            </form>
                            <form asp-action="RunNow" asp-route-id="@s.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Preview only: shows recipients and messages for this notification type. Nothing is sent. Continue?');">
                                <button class="btn btn-sm btn-success">Run Now (test)</button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this setting and its logs?');">
                                <button class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

    <section class="nova-list-card" aria-label="Recent activity log">
    <div class="nova-list-toolbar">
        <div class="nova-list-heading"><span class="nova-list-heading-icon" aria-hidden="true"><i class="fa fa-list-ul"></i></span><div><h2>Recent activity log</h2><p>Latest 50 automation events</p></div></div>
        <div class="nova-list-controls"><label class="nova-search" for="search-novaActivityTable"><i class="fa fa-search" aria-hidden="true"></i><span class="sr-only">Search Recent activity log</span><input type="search" id="search-novaActivityTable" data-nova-search="novaActivityTable" placeholder="Search records..." autocomplete="off" /></label></div>
    </div>
    <div class="nova-table-viewport">
<table id="novaActivityTable" class="table table-sm table-bordered">
            <thead><tr><th>When</th><th>Setting</th><th>Recipient</th><th>Phone</th><th>Status</th><th>Note</th></tr></thead>
            <tbody>
                @foreach (var l in logs)
                {
                    <tr>
                        <td>@l.When</td>
                        <td>@l.SettingName</td>
                        <td>@(string.IsNullOrEmpty(l.RecipientName) ? $"{l.RecipientType} #{l.RecipientId}" : l.RecipientName)</td>
                        <td>@l.Phone</td>
                        <td>@l.Status</td>
                        <td>@l.Error</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
</div>