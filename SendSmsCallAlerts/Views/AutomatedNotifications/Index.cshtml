@model IEnumerable<SendSmsCallAlerts.Models.AutomatedSmsSetting>
@using SendSmsCallAlerts.Controllers
@{
    ViewData["Title"] = "Automated SMS";
    var logs = (List<AutomatedLogRow>)ViewBag.RecentLogs;
    var days = new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
}

<partial name="_AutoSmsHead" />

<div style="padding:20px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Automated SMS</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa fa-plus me-1"></i> New setting
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success"><b>@TempData["Success"]</b></div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead style="background: #70b3db; color: white;">
                <tr>
                    <th>Name</th>
                    <th>Recipients</th>
                    <th>Schedule</th>
                    <th>Message</th>
                    <th>Active</th>
                    <th style="width:330px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    var time = DateTime.Today.Add(s.SendTime).ToString("hh:mm tt");
                    var schedule = s.Frequency == "Weekly"
                        ? $"Every {days[s.DayOfWeek ?? 0]} at {time}"
                        : $"Every day at {time}";
                    <tr>
                        <td>@s.Name</td>
                        <td>@s.RecipientType</td>
                        <td>@schedule</td>
                        <td style="white-space:pre-wrap">@s.TemplateBody</td>
                        <td>@(s.IsActive ? "Yes" : "No")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-primary">Edit</a>
                            <form asp-action="ToggleActive" asp-route-id="@s.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-warning">@(s.IsActive ? "Deactivate" : "Activate")</button>
                            </form>
                            <form asp-action="RunNow" asp-route-id="@s.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Preview only: shows who would get what tomorrow. Nothing is sent. Continue?');">
                                <button class="btn btn-sm btn-success">Run Now (test)</button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this setting and its logs?');">
                                <button class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h5 class="mt-4">Recent activity (last 50)</h5>
    <div class="table-responsive">
        <table class="table table-sm table-bordered">
            <thead><tr><th>When</th><th>Setting</th><th>Recipient</th><th>Phone</th><th>Status</th><th>Note</th></tr></thead>
            <tbody>
                @foreach (var l in logs)
                {
                    <tr>
                        <td>@l.When</td>
                        <td>@l.SettingName</td>
                        <td>@(string.IsNullOrEmpty(l.RecipientName) ? $"{l.RecipientType} #{l.RecipientId}" : l.RecipientName)</td>
                        <td>@l.Phone</td>
                        <td>@l.Status</td>
                        <td>@l.Error</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>