@model List<SchedulerViewModel>

@{
    ViewData["Title"] = "Schedulers";
}

<section class="nova-page-head" aria-label="Page heading">
    <div class="nova-heading-group">
        <span class="nova-heading-icon" aria-hidden="true"><i class="fa fa-calendar-o"></i></span>
        <div class="nova-heading-copy">
            <span class="nova-eyebrow">SCHEDULE LIBRARY</span>
            <h1>Schedulers</h1>
            <p>Manage templates and execution schedules</p>
        </div>
    </div>
    <div class="nova-page-actions">
        <a asp-action="IncomingLogs" asp-controller="Sms" class="btn btn-outline-secondary btn-sm sg-secondary-action">
        <i class="fa fa-arrow-left me-1"></i> Back to SMS Logs
    </a>
        <a asp-action="Create" class="btn btn-primary sg-primary-action">Create New Template</a>
    </div>
</section>
@if (TempData["ErrMsg"] != null)
{
    <div class="alert alert-danger"><b>@TempData["ErrMsg"]</b></div>
}
@if (TempData["SucMsg"] != null)
{
    <div class="alert alert-success"><b>@TempData["SucMsg"]</b></div>
}


<section class="nova-list-card sg-fix-schedulers" aria-label="All Schedulers">
    <div class="nova-list-toolbar">
        <div class="nova-list-heading"><span class="nova-list-heading-icon" aria-hidden="true"><i class="fa fa-list-ul"></i></span><div><h2>All Schedulers</h2><p>Manage templates and execution schedules</p></div></div>
        <div class="nova-list-controls"><label class="nova-search" for="search-novaSchedulersTable"><i class="fa fa-search" aria-hidden="true"></i><span class="sr-only">Search All Schedulers</span><input type="search" id="search-novaSchedulersTable" data-nova-search="novaSchedulersTable" placeholder="Search records..." autocomplete="off" /></label></div>
    </div>
    <div class="nova-table-viewport">
<table id="novaSchedulersTable" class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayName("Name")
            </th>
            @*  <th>
                @Html.DisplayName("Template")
            </th>*@

            <th>
                @Html.DisplayName("Body")
            </th>
            <th>
                @Html.DisplayName("Execution Type")
            </th>
            <th>
                @Html.DisplayName("Time")
            </th>
            <th>
                @Html.DisplayName("Status")
            </th>
            @*  <th>
            @Html.DisplayNameFor(model => model.createdOn)
            </th>*@
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.name)
                </td>
                @*                <td>
                    @Html.DisplayFor(modelItem => item.templateOrAudioName)
                </td>*@
                <td>
                    @Html.DisplayFor(modelItem => item.smsBody)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.onceOrRepeat)
                </td>
                <td>
                    @if (item.onceOrRepeat == "Once")
                    {
                        @Html.DisplayFor(modelItem => item.executionDateAndTimeSt)
                    }
                    else
                    {
                        @Html.DisplayFor(modelItem => item.executionTimeSt)
                    }

                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.status)
                </td>
                @*   <td>
            @Html.DisplayFor(modelItem => item.createdOn)
            </td>*@
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Edit</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this scheduler template?');">
                        @* <a asp-action="Details" asp-route-id="@item.Id">Details</a> |*@
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
</section>