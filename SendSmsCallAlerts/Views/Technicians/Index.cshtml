@model IEnumerable<SendSmsCallAlerts.Models.Technician>

@{
    ViewData["Title"] = "Technicians";
    var technicianViewModels = ViewBag.TechnicianViewModels as List<dynamic>;
    var availabilitySummaries = ViewBag.AvailabilitySummaries as Dictionary<int, string>;
    var jobCounts = ViewBag.JobCounts as Dictionary<int, int>;
    var todayAvailable = ViewBag.TodayAvailable as Dictionary<int, bool>;
    var cities = ViewBag.Cities as List<string>;
    var categories = ViewBag.Categories as List<SendSmsCallAlerts.Models.IvrOptions>;
}

<div class="sg-content-stack">
    <section class="nova-page-head" aria-label="Page heading">
        <div class="nova-heading-group">
            <span class="nova-heading-icon" aria-hidden="true"><i class="fa fa-wrench"></i></span>
            <div class="nova-heading-copy">
                <span class="nova-eyebrow">TEAM</span>
                <h1>Technicians</h1>
                <p>Manage field technicians and assignments</p>
            </div>
        </div>
        <div class="nova-page-actions">
            <a asp-action="Create" class="btn btn-primary sg-primary-action">
                <i class="fa fa-plus me-1"></i> Add technician
            </a>
        </div>
    </section>

    <section class="nova-list-card sg-fix-tech" aria-label="All Technicians">
        <div class="nova-list-toolbar">
            <div class="nova-list-heading">
                <span class="nova-list-heading-icon" aria-hidden="true"><i class="fa fa-list-ul"></i></span>
                <div>
                    <h2>All Technicians</h2>
                    <p>Manage field technicians and assignments</p>
                </div>
            </div>
            <div class="nova-list-controls">
                <label class="nova-search" for="search-tblTechnicians">
                    <i class="fa fa-search" aria-hidden="true"></i>
                    <span class="sr-only">Search technicians</span>
                    <input type="search" id="search-tblTechnicians" data-nova-search="tblTechnicians" placeholder="Search name, phone, city..." autocomplete="off" />
                </label>
            </div>
        </div>

        <div class="sg-tech-filters">
            <div class="sg-filter-group">
                <label for="filterCategory" class="sg-filter-label">Category</label>
                <select id="filterCategory" class="form-select form-select-sm sg-filter-select" data-filter-type="category">
                    <option value="">All Categories</option>
                    @if (categories != null)
                    {
                        @foreach (var cat in categories.OrderBy(c => c.keyword))
                        {
                            <option value="@cat.keyword">@cat.keyword</option>
                        }
                    }
                </select>
            </div>

            <div class="sg-filter-group">
                <label for="filterCity" class="sg-filter-label">City/State</label>
                <select id="filterCity" class="form-select form-select-sm sg-filter-select" data-filter-type="city">
                    <option value="">All Cities</option>
                    @if (cities != null)
                    {
                        @foreach (var city in cities)
                        {
                            <option value="@city">@city</option>
                        }
                    }
                </select>
            </div>

            <div class="sg-filter-group">
                <label for="filterAvailability" class="sg-filter-label">Today</label>
                <select id="filterAvailability" class="form-select form-select-sm sg-filter-select" data-filter-type="availability">
                    <option value="">All</option>
                    <option value="available">Available</option>
                    <option value="off">Off</option>
                </select>
            </div>

            <div class="sg-filter-group">
                <label for="pageSize" class="sg-filter-label">Per Page</label>
                <select id="pageSize" class="form-select form-select-sm sg-filter-select" data-page-size="true">
                    <option value="10">10</option>
                    <option value="25" selected>25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>

            <button type="button" id="clearFilters" class="btn btn-sm btn-outline-secondary sg-clear-filters" title="Clear all filters">
                <i class="fa fa-times me-1"></i> Clear
            </button>
        </div>

        <div class="nova-table-viewport">
            <table id="tblTechnicians" class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th class="sg-sortable" data-sort="name"><i class="fa fa-sort"></i> Name</th>
                        <th class="sg-sortable" data-sort="phone"><i class="fa fa-sort"></i> Phone</th>
                        <th class="sg-sortable" data-sort="location"><i class="fa fa-sort"></i> Location</th>
                        <th class="sg-sortable" data-sort="categories"><i class="fa fa-sort"></i> Categories</th>
                        <th class="sg-sortable" data-sort="availability"><i class="fa fa-sort"></i> Availability</th>
                        <th class="sg-sortable" data-sort="jobs" data-sort-dir="desc"><i class="fa fa-sort"></i> Jobs</th>
                        <th class="sg-sortable" data-sort="today"><i class="fa fa-sort"></i> Today</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (technicianViewModels != null && technicianViewModels.Count > 0)
                    {
                        @foreach (var item in technicianViewModels)
                        {
                            var tech = (SendSmsCallAlerts.Models.Technician)item.Technician;
                            var categoryNames = (List<string>)item.CategoryNames;
                            var availabilityText = availabilitySummaries?.ContainsKey(tech.Id) == true
                                ? availabilitySummaries[tech.Id]
                                : "Not configured";
                            var upcomingJobs = jobCounts?.ContainsKey(tech.Id) == true ? jobCounts[tech.Id] : 0;
                            var isAvailableToday = todayAvailable?.ContainsKey(tech.Id) == true && todayAvailable[tech.Id];
                            var categoryDisplay = categoryNames != null && categoryNames.Any()
                                ? string.Join(" ", categoryNames.Take(2).Select(c => $"<span class=\"sg-tech-badge\">{c}</span>"))
                                  + (categoryNames.Count > 2 ? $" <span class=\"sg-tech-badge sg-tech-badge--more\">+{categoryNames.Count - 2}</span>" : "")
                                : "<span class=\"text-muted\">—</span>";

                            <tr>
                                <td class="sg-tech-name">@tech.FullName</td>
                                <td class="sg-tech-phone">@tech.ContactNumber</td>
                                <td class="sg-tech-location">
                                    <div>@(tech.CityState ?? "—")</div>
                                    <div class="text-muted small">@(tech.ZipCode ?? "—")</div>
                                </td>
                                <td class="sg-tech-categories" title="@(categoryNames != null ? string.Join(", ", categoryNames) : "No categories")">@Html.Raw(categoryDisplay)</td>
                                <td class="sg-tech-availability">@availabilityText</td>
                                <td class="sg-tech-jobs text-center">@upcomingJobs</td>
                                <td class="sg-tech-today">
                                    <span class="nova-status @(isAvailableToday ? "nova-status--active" : "nova-status--muted")">
                                        @(isAvailableToday ? "Available" : "Off")
                                    </span>
                                </td>
                                <td class="sg-tech-actions">
                                    <div class="sg-action-buttons">
                                        <a href="@Url.Action("Edit", new { id = tech.Id })" class="btn btn-sm btn-primary">
                                            <i class="fa fa-pencil"></i> Edit
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@tech.Id" method="post" style="display: inline;"
                                              onsubmit="return confirmDelete(event, 'Delete this technician? This cannot be undone.', this);">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="fa fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('search-tblTechnicians');
        const table = document.getElementById('tblTechnicians');
        const categoryFilter = document.getElementById('filterCategory');
        const cityFilter = document.getElementById('filterCity');
        const availabilityFilter = document.getElementById('filterAvailability');
        const pageSizeSelect = document.getElementById('pageSize');
        const clearFiltersBtn = document.getElementById('clearFilters');
        const sortHeaders = document.querySelectorAll('.sg-sortable');

        let currentPage = 1;
        let sortColumn = null;
        let sortDir = 'asc';
        let filteredRows = [];

        if (!table) return;

        // Store original rows for filtering
        const allRows = Array.from(table.querySelectorAll('tbody tr'));

        // Sorting
        sortHeaders.forEach(header => {
            header.addEventListener('click', function () {
                const column = this.dataset.sort;
                sortDir = this.dataset.sortDir === 'desc' ? 'asc' : 'desc';
                this.dataset.sortDir = sortDir;

                // Update icon
                sortHeaders.forEach(h => h.classList.remove('sg-sort-active'));
                this.classList.add('sg-sort-active');

                sortRows(column, sortDir);
                applyPagination();
            });
        });

        function sortRows(column, dir) {
            filteredRows.sort((rowA, rowB) => {
                let valA, valB;
                switch (column) {
                    case 'name':
                        valA = rowA.querySelector('.sg-tech-name')?.textContent || '';
                        valB = rowB.querySelector('.sg-tech-name')?.textContent || '';
                        break;
                    case 'phone':
                        valA = rowA.querySelector('.sg-tech-phone')?.textContent || '';
                        valB = rowB.querySelector('.sg-tech-phone')?.textContent || '';
                        break;
                    case 'location':
                        valA = rowA.querySelector('.sg-tech-location')?.textContent || '';
                        valB = rowB.querySelector('.sg-tech-location')?.textContent || '';
                        break;
                    case 'categories':
                        valA = rowA.querySelector('.sg-tech-categories')?.textContent || '';
                        valB = rowB.querySelector('.sg-tech-categories')?.textContent || '';
                        break;
                    case 'availability':
                        valA = rowA.querySelector('.sg-tech-availability')?.textContent || '';
                        valB = rowB.querySelector('.sg-tech-availability')?.textContent || '';
                        break;
                    case 'jobs':
                        valA = parseInt(rowA.querySelector('.sg-tech-jobs')?.textContent || 0);
                        valB = parseInt(rowB.querySelector('.sg-tech-jobs')?.textContent || 0);
                        break;
                    case 'today':
                        valA = rowA.querySelector('.sg-tech-today')?.textContent || '';
                        valB = rowB.querySelector('.sg-tech-today')?.textContent || '';
                        break;
                    default:
                        return 0;
                }

                if (typeof valA === 'string') {
                    return dir === 'asc' ? valA.localeCompare(valB) : valB.localeCompare(valA);
                } else {
                    return dir === 'asc' ? valA - valB : valB - valA;
                }
            });
        }

        // Filtering
        function applyFilters() {
            const searchQuery = searchInput.value.toLowerCase();
            const categoryVal = categoryFilter.value;
            const cityVal = cityFilter.value;
            const availabilityVal = availabilityFilter.value;

            filteredRows = allRows.filter(row => {
                const name = row.querySelector('.sg-tech-name')?.textContent || '';
                const phone = row.querySelector('.sg-tech-phone')?.textContent || '';
                const location = row.querySelector('.sg-tech-location')?.textContent || '';
                const combined = (name + ' ' + phone + ' ' + location).toLowerCase();

                // Search filter
                if (searchQuery && !combined.includes(searchQuery)) return false;

                // Category filter
                if (categoryVal) {
                    const categories = row.querySelector('.sg-tech-categories')?.textContent || '';
                    if (!categories.includes(categoryVal)) return false;
                }

                // City filter
                if (cityVal) {
                    const locText = row.querySelector('.sg-tech-location')?.textContent || '';
                    if (!locText.includes(cityVal)) return false;
                }

                // Availability filter
                if (availabilityVal) {
                    const today = row.querySelector('.sg-tech-today .nova-status')?.textContent?.trim() || '';
                    if (availabilityVal === 'available' && today !== 'Available') return false;
                    if (availabilityVal === 'off' && today !== 'Off') return false;
                }

                return true;
            });

            currentPage = 1;
            applyPagination();
        }

        function applyPagination() {
            const pageSize = parseInt(pageSizeSelect.value);
            const totalPages = Math.ceil(filteredRows.length / pageSize);
            const start = (currentPage - 1) * pageSize;
            const end = start + pageSize;

            allRows.forEach(row => row.style.display = 'none');
            filteredRows.slice(start, end).forEach(row => row.style.display = '');

            updatePaginationInfo();
        }

        function updatePaginationInfo() {
            const pageSize = parseInt(pageSizeSelect.value);
            const totalPages = Math.ceil(filteredRows.length / pageSize);
            // Can add pagination info display here if needed
        }

        // Event listeners
        searchInput.addEventListener('input', applyFilters);
        categoryFilter.addEventListener('change', applyFilters);
        cityFilter.addEventListener('change', applyFilters);
        availabilityFilter.addEventListener('change', applyFilters);
        pageSizeSelect.addEventListener('change', applyPagination);

        clearFiltersBtn.addEventListener('click', function () {
            searchInput.value = '';
            categoryFilter.value = '';
            cityFilter.value = '';
            availabilityFilter.value = '';
            pageSizeSelect.value = '25';
            sortHeaders.forEach(h => {
                h.classList.remove('sg-sort-active');
                h.dataset.sortDir = 'asc';
            });
            applyFilters();
        });

        // Initial load
        applyFilters();
    });
</script>
