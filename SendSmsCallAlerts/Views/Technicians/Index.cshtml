@model IEnumerable<SendSmsCallAlerts.Models.Technician>

@{
    ViewData["Title"] = "Technicians";
    var technicianViewModels = ViewBag.TechnicianViewModels as List<dynamic>;
    var availabilitySummaries = ViewBag.AvailabilitySummaries as Dictionary<int, string>;   // CHANGE 1
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.1/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.datatables.net/1.12.1/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<style>
    .category-badge {
        display: inline-block;
        padding: 4px 10px;
        margin: 2px;
        background-color: #e3f2fd;
        border: 1px solid #90caf9;
        border-radius: 12px;
        font-size: 0.85rem;
        color: #1976d2;
    }
</style>

<div class="sg-content-stack">
    <section class="nova-page-head" aria-label="Page heading">
    <div class="nova-heading-group">
        <span class="nova-heading-icon" aria-hidden="true"><i class="fa fa-wrench"></i></span>
        <div class="nova-heading-copy">
            <span class="nova-eyebrow">TEAM DIRECTORY</span>
            <h1>Technicians</h1>
            <p>Manage field technicians, assignments and availability</p>
        </div>
    </div>
    <div class="nova-page-actions">
        <a asp-action="IncomingLogs" asp-controller="Sms" class="btn btn-outline-secondary btn-sm sg-secondary-action">
            <i class="fa fa-arrow-left me-1"></i> Back to SMS Logs
        </a>
        <a asp-action="Create" class="btn btn-primary sg-primary-action">
            <i class="fa fa-plus me-1"></i> Create New Technician
        </a>
    </div>
</section>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <b>@TempData["SuccessMessage"]</b>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    

    <section class="nova-list-card sg-fix-tech" aria-label="All Technicians">
    <div class="nova-list-toolbar">
        <div class="nova-list-heading"><span class="nova-list-heading-icon" aria-hidden="true"><i class="fa fa-list-ul"></i></span><div><h2>All Technicians</h2><p>Manage field technicians, assignments and availability</p></div></div>
        <div class="nova-list-controls"><span class="nova-table-hint"><i class="fa fa-sliders" aria-hidden="true"></i> Use the table filters below</span></div>
    </div>
    <div class="nova-table-viewport">
<table class="table table-bordered table-striped" id="tblTechnicians">
        <thead style="background: #70b3db; color: white;">
            <tr>
                <th>Name</th>
                <th>Contact Number</th>
                <th>Street Address</th>
                <th>City/State</th>
                <th>ZIP Code</th>
                <th>Categories</th>
                <th>Availability</th> @* CHANGE 2 *@
                <th style="width: 150px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (technicianViewModels != null && technicianViewModels.Count > 0)
            {
                @foreach (var item in technicianViewModels)
                {
                    var tech = (SendSmsCallAlerts.Models.Technician)item.Technician;
                    var categoryNames = (List<string>)item.CategoryNames;
                    var availabilityText = (availabilitySummaries != null && availabilitySummaries.ContainsKey(tech.Id))
                        ? availabilitySummaries[tech.Id]
                        : "Not configured";

                    <tr>
                        <td>@tech.FullName</td>
                        <td>@tech.ContactNumber</td>
                        <td>@(tech.StreetAddress ?? "N/A")</td>
                        <td>@(tech.CityState ?? "N/A")</td>
                        <td>@(tech.ZipCode ?? "N/A")</td>
                        <td>
                            @if (categoryNames != null && categoryNames.Any())
                            {
                                @foreach (var category in categoryNames)
                                {
                                    <span class="category-badge">@category</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">No categories assigned</span>
                            }
                        </td>
                        <td>@* CHANGE 3 *@
                            @if (availabilityText == "Not configured")
                            {
                                <span class="text-muted">Not configured</span>
                            }
                            else
                            {
                                <small>@availabilityText</small>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@tech.Id" class="btn btn-sm btn-primary">
                                <i class="fa fa-edit"></i> Edit
                            </a>
                            <button onclick="deleteTechnician(@tech.Id)" class="btn btn-sm btn-danger">
                                <i class="fa fa-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            }
            
        </tbody>
    </table>
    </div>
</section>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.1/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.12.1/js/dataTables.bootstrap5.min.js"></script>

<script>
    var techTableJQuery = window.jQuery;

    techTableJQuery(function () {
        techTableJQuery('#tblTechnicians').DataTable({
            "order": [[0, 'asc']],
            "pageLength": 25,
            "columnDefs": [{ "targets": 7, "orderable": false }],
            "language": {
                "emptyTable": "No technicians found. <a href='@Url.Action("Create", "Technicians")'>Create one now</a>"
            }
        });
    });

    function deleteTechnician(id) {
        if (confirm('Are you sure you want to delete this technician?')) {
            techTableJQuery.post('@Url.Action("Delete", "Technicians")', { id: id }, function (response) {
                if (response.success) {
                    alert(response.message);
                    location.reload();
                } else {
                    alert(response.message);
                }
            });
        }
    }
</script>
