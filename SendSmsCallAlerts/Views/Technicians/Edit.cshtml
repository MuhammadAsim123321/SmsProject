@model SendSmsCallAlerts.Models.Technician

@{
    ViewData["Title"] = "Edit technician";
    var categories = ViewBag.Categories as List<SendSmsCallAlerts.Models.IvrOptions>;
    var selectedCategoryIds = ViewBag.SelectedCategoryIds as string[];
    var availability = ViewBag.Availability as List<SendSmsCallAlerts.Models.TechnicianAvailability>;
}

<div class="sg-content-stack">
    <section class="nova-page-head" aria-label="Page heading">
        <div class="nova-heading-group">
            <span class="nova-heading-icon" aria-hidden="true"><i class="fa fa-pencil-square-o"></i></span>
            <div class="nova-heading-copy">
                <span class="nova-eyebrow">EDIT</span>
                <h1>@Model.FullName</h1>
                <p>Update technician profile and availability</p>
            </div>
        </div>
    </section>

    <form asp-action="Edit" method="post" onsubmit="return confirmAction(event, 'Edit Technician', 'Are you sure you want to save changes to this technician?', this);">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="sg-form-card">
            <div class="sg-form-card-header">
                <h3>Contact Information</h3>
            </div>
            <div class="sg-form-card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ContactNumber" class="form-label"></label>
                    <input asp-for="ContactNumber" class="form-control" />
                    <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StreetAddress" class="form-label"></label>
                    <input asp-for="StreetAddress" class="form-control" />
                    <span asp-validation-for="StreetAddress" class="text-danger small"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-8">
                        <label asp-for="CityState" class="form-label"></label>
                        <input asp-for="CityState" class="form-control" placeholder="City, Region, Country" />
                        <span asp-validation-for="CityState" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ZipCode" class="form-label"></label>
                        <input asp-for="ZipCode" class="form-control" placeholder="ZIP / postal code" />
                        <span asp-validation-for="ZipCode" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="sg-form-card">
            <div class="sg-form-card-header">
                <h3>Service Categories</h3>
            </div>
            <div class="sg-form-card-body">
                <div class="sg-category-list">
                    @if (categories != null && categories.Any())
                    {
                        @foreach (var category in categories)
                        {
                            var isChecked = selectedCategoryIds != null && selectedCategoryIds.Contains(category.Id.ToString());
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="selectedCategories" 
                                       value="@category.Id" id="cat_@category.Id" 
                                       @(isChecked ? "checked" : "")>
                                <label class="form-check-label" for="cat_@category.Id">
                                    @category.keyword
                                </label>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No categories available.</p>
                    }
                </div>
                <small class="form-text text-muted mt-2 d-block">Select all service categories this technician can handle.</small>
            </div>
        </div>

        <div class="sg-form-card">
            <div class="sg-form-card-header">
                <h3>Weekly Availability</h3>
            </div>
            <div class="sg-form-card-body">
                <partial name="_AvailabilityEditor" model="availability" />
            </div>
        </div>

        <div class="sg-form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="fa fa-save me-1"></i> Save Changes
            </button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
